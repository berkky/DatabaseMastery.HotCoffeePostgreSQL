@{
    Layout = null;
    var adminDisplayName = User.Identity?.Name ?? "Admin";
    var adminInitial = adminDisplayName.Length > 0
        ? adminDisplayName.Substring(0, 1).ToUpperInvariant()
        : "A";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HotCoffee Yönetim Paneli</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/hotcoffee-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hotcoffee-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hotcoffee-admin-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hotcoffee-admin-flash.css" asp-append-version="true" />
    @await RenderSectionAsync("AdminStyles", required: false)
</head>
<body class="hc-admin" data-hc-shell="admin">
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    }

    <div id="sidebar-overlay" onclick="closeSidebar()" aria-hidden="true"></div>

    <aside id="sidebar" aria-label="Yönetim menüsü">
        <a asp-controller="Menu" asp-action="Index" class="sidebar-brand">
            <div class="brand-logo">
                <i class="bi bi-cup-hot-fill"></i>
            </div>
            <div class="brand-text">
                <div class="brand-name">HotCoffee</div>
                <div class="brand-sub">Yönetim Paneli</div>
            </div>
        </a>

        <nav class="sidebar-nav">
            <div class="nav-section-label">Ana Menü</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                       asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill nav-icon"></i>
                        <span class="nav-label">Dashboard</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Category" ? "active" : "")"
                       asp-controller="Category" asp-action="CategoryCardList">
                        <i class="bi bi-tags-fill nav-icon"></i>
                        <span class="nav-label">Kategoriler</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Product" ? "active" : "")"
                       asp-controller="Product" asp-action="ProductList">
                        <i class="bi bi-basket3-fill nav-icon"></i>
                        <span class="nav-label">Ürünler</span>
                    </a>
                </li>
            </ul>

            <div class="nav-section-label">Operasyonlar</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Reservation" ? "active" : "")"
                       asp-controller="Reservation" asp-action="ReservationList">
                        <i class="bi bi-calendar2-check-fill nav-icon"></i>
                        <span class="nav-label">Rezervasyonlar</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Review" ? "active" : "")"
                       asp-controller="Review" asp-action="ReviewList">
                        <i class="bi bi-chat-square-dots-fill nav-icon"></i>
                        <span class="nav-label">Yorumlar</span>
                    </a>
                </li>
            </ul>

            <div class="nav-section-label">Analiz</div>
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link @(currentController == "Statistics" ? "active" : "")"
                       asp-controller="Statistics" asp-action="Index">
                        <i class="bi bi-bar-chart-line-fill nav-icon"></i>
                        <span class="nav-label">İstatistikler</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <div class="sidebar-user">
                <div class="user-avatar">@adminInitial</div>
                <div class="user-info">
                    <div class="user-name">@adminDisplayName</div>
                    <div class="user-role">Yönetici</div>
                </div>
            </div>
        </div>
    </aside>

    <div id="main-wrapper">
        <header id="top-navbar">
            <button type="button"
                    class="sidebar-toggle-btn"
                    id="sidebarToggle"
                    onclick="toggleSidebar()"
                    aria-controls="sidebar"
                    aria-expanded="false"
                    aria-label="Menüyü aç">
                <i class="bi bi-list" aria-hidden="true"></i>
            </button>

            <span class="navbar-page-title">@ViewData["Title"]</span>

            <div class="navbar-actions">
                <div class="navbar-dropdown dropdown">
                    <button type="button" class="nav-action-btn dropdown-toggle" data-bs-toggle="dropdown" aria-label="Hızlı bağlantılar">
                        <i class="bi bi-lightning-fill" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li><h6 class="dropdown-header hc-dropdown-header">Hızlı Bağlantılar</h6></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Product" asp-action="CreateProduct">
                                <i class="bi bi-plus-circle-fill"></i>
                                Yeni Ürün Ekle
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Category" asp-action="CreateCategory">
                                <i class="bi bi-folder-plus"></i>
                                Yeni Kategori Ekle
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Review" asp-action="CreateReview">
                                <i class="bi bi-chat-square-dots-fill"></i>
                                Yeni Yorum Ekle
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" asp-controller="Reservation" asp-action="ReservationList">
                                <i class="bi bi-calendar2-check-fill"></i>
                                Rezervasyonları Gör
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="navbar-divider"></div>

                <div class="navbar-dropdown dropdown">
                    <button type="button" class="user-nav-btn dropdown-toggle" data-bs-toggle="dropdown" aria-label="Kullanıcı menüsü">
                        <div class="user-nav-avatar">@adminInitial</div>
                        <span class="user-nav-name d-none d-sm-inline">@adminDisplayName</span>
                        <i class="bi bi-chevron-down user-nav-chevron" aria-hidden="true"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            <div class="hc-user-dropdown-head">
                                <div class="hc-user-dropdown-name">@adminDisplayName</div>
                                <div class="hc-user-dropdown-role">Yönetici hesabı</div>
                            </div>
                        </li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item hc-logout-btn">
                                    <i class="bi bi-box-arrow-right"></i>
                                    Çıkış Yap
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main id="main-content">
            <div class="content-card">
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/hotcoffee-admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
