@{
    Layout = null;
    ViewData["Title"] = "Erişim Reddedildi";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HotCoffee</title>
    <link rel="stylesheet" href="~/css/hotcoffee-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hotcoffee-login.css" asp-append-version="true" />
</head>
<body class="hc-login hc-access-denied">
    <div class="denied-card">
        <h1>Erişim Reddedildi</h1>
        <p>Bu sayfayı görüntüleme yetkiniz bulunmuyor.</p>
        <a class="btn-back" asp-controller="Account" asp-action="Login">Giriş Sayfasına Dön</a>
    </div>
</body>
</html>
