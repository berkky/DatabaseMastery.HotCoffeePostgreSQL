@model DatabaseMastery.HotCoffeePostgreSQL.Models.ViewModels.AdminLoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Yönetici Girişi";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — HotCoffee</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <style>
        :root {
            --bg: #141210;
            --card: #1e1a17;
            --border: #3a322c;
            --text: #f5f0ea;
            --muted: #9a9088;
            --accent: #e6a03c;
            --accent-dark: #c8861e;
            --danger: #ef4444;
        }

        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: radial-gradient(circle at top, #2a221c 0%, var(--bg) 55%);
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .login-shell {
            width: 100%;
            max-width: 420px;
        }

        .login-brand {
            text-align: center;
            margin-bottom: 28px;
        }

        .login-brand h1 {
            font-size: 1.65rem;
            font-weight: 700;
            margin: 0 0 6px;
            letter-spacing: 0.02em;
        }

        .login-brand p {
            color: var(--muted);
            font-size: 0.95rem;
            margin: 0;
        }

        .login-card {
            background: var(--card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 28px 26px 24px;
            box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
        }

        .form-label {
            color: var(--muted);
            font-size: 0.82rem;
            font-weight: 600;
            letter-spacing: 0.04em;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .form-control {
            background: #12100e;
            border: 1px solid var(--border);
            color: var(--text);
            border-radius: 10px;
            padding: 11px 14px;
        }

        .form-control:focus {
            background: #12100e;
            color: var(--text);
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(230, 160, 60, 0.18);
        }

        .btn-login {
            width: 100%;
            border: none;
            border-radius: 10px;
            padding: 12px 16px;
            font-weight: 700;
            font-size: 0.95rem;
            color: #1a1208;
            background: linear-gradient(135deg, var(--accent), var(--accent-dark));
            margin-top: 8px;
        }

        .btn-login:hover {
            filter: brightness(1.05);
        }

        .alert-errors {
            background: rgba(239, 68, 68, 0.12);
            border: 1px solid rgba(239, 68, 68, 0.35);
            color: #fecaca;
            border-radius: 10px;
            padding: 10px 12px;
            font-size: 0.9rem;
            margin-bottom: 16px;
        }

        .field-error {
            color: #fca5a5;
            font-size: 0.82rem;
            margin-top: 4px;
        }

        .login-footer {
            text-align: center;
            margin-top: 18px;
            color: var(--muted);
            font-size: 0.82rem;
        }
    </style>
</head>
<body>
    <div class="login-shell">
        <div class="login-brand">
            <h1>HotCoffee Admin</h1>
            <p>Yönetim paneline giriş yapın</p>
        </div>

        <div class="login-card">
            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
            {
                <div class="alert-errors" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <form asp-action="Login" asp-controller="Account" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" />
                    <span asp-validation-for="Username" class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <button type="submit" class="btn-login">Giriş Yap</button>
            </form>
        </div>

        <div class="login-footer">
            Yetkisiz erişim yasaktır.
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
