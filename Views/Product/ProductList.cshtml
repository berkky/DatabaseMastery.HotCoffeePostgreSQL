@model List<ResultProductDto>

@{
    ViewData["Title"] = "ProductList";
    Layout = "~/Views/AdminLayout/Index.cshtml";
    var categories = Model?.Select(p => new { p.CategoryId, p.CategoryName })
                         .DistinctBy(c => c.CategoryId)
                         .OrderBy(c => c.CategoryName)
                         .ToList();
    var total = Model?.Count ?? 0;
    var active = Model?.Count(p => p.Status) ?? 0;
    var passive = total - active;
    var avgPrice = Model?.Any() == true ? Model.Average(p => p.Price) : 0;
}
<partial name="_AdminFlashMessagesPartial" />

<!-- ── PAGE HEADER ── -->
<div class="pg-header">
    <div>
        <h1 class="pg-title">
            <i class="bi bi-basket3-fill me-2" style="color:var(--accent);font-size:20px;vertical-align:middle;"></i>
            Ürün Yönetimi
        </h1>
        <p class="pg-desc">Menüdeki tüm yemek ve içecekleri yönetin.</p>
    </div>
    <a href="/Product/CreateProduct" class="btn-add">
        <i class="bi bi-plus-lg"></i>
        Yeni Ürün Ekle
    </a>
</div>

<!-- ── STAT CARDS ── -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:#f5f2ee;">
            <i class="bi bi-basket3-fill" style="color:#aaa;"></i>
        </div>
        <div>
            <div class="stat-num">@total</div>
            <div class="stat-lbl">Toplam Ürün</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--green-soft);">
            <i class="bi bi-check-circle-fill" style="color:var(--green);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#16a34a;">@active</div>
            <div class="stat-lbl">Aktif Ürün</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--red-soft);">
            <i class="bi bi-pause-circle-fill" style="color:var(--red);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#dc2626;">@passive</div>
            <div class="stat-lbl">Pasif Ürün</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--blue-soft);">
            <i class="bi bi-tags-fill" style="color:var(--blue);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:var(--blue);">@(categories?.Count ?? 0)</div>
            <div class="stat-lbl">Kategori</div>
        </div>
    </div>
</div>

<!-- ── TOOLBAR ── -->
<div class="toolbar">
    <div class="search-wrap">
        <i class="bi bi-search si"></i>
        <input type="text" class="search-input" id="searchInput"
               placeholder="Ürün adı veya açıklama ara..."
               oninput="filterTable()" />
    </div>

    <select class="f-select" id="catFilter" onchange="filterTable()">
        <option value="all">Tüm Kategoriler</option>
        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <option value="@cat.CategoryId">@cat.CategoryName</option>
            }
        }
    </select>

    <select class="f-select" id="statusFilter" onchange="filterTable()">
        <option value="all">Tüm Durumlar</option>
        <option value="active">Aktif</option>
        <option value="passive">Pasif</option>
    </select>

    <select class="f-select" id="sortSelect" onchange="sortTable()">
        <option value="default">Sıralama</option>
        <option value="name-asc">Ad A→Z</option>
        <option value="name-desc">Ad Z→A</option>
        <option value="price-asc">Fiyat ↑</option>
        <option value="price-desc">Fiyat ↓</option>
        <option value="cat-asc">Kategori A→Z</option>
    </select>

    <div class="toolbar-right">
        <span class="result-count" id="resultCount">@total ürün listeleniyor</span>
    </div>
</div>

<!-- ── TABLE CARD ── -->
<div class="tbl-card">
    <div style="overflow-x:auto;">
        <table class="prod-table" id="prodTable">
            <thead>
                <tr>
                    <th class="col-num no-sort">#</th>
                    <th class="col-img no-sort">Görsel</th>
                    <th class="col-name" onclick="sortBy('name')">
                        Ürün Adı <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="col-cat" onclick="sortBy('cat')">
                        Kategori <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="col-price" onclick="sortBy('price')" style="text-align:right;">
                        Fiyat <i class="bi bi-chevron-expand sort-icon"></i>
                    </th>
                    <th class="col-status no-sort">Durum</th>
                    <th class="col-act no-sort">İşlemler</th>
                </tr>
            </thead>
            <tbody id="prodBody">

                @if (Model == null || !Model.Any())
                {
                    <tr class="empty-row">
                        <td colspan="7">
                            <div class="empty-inner">
                                <div class="empty-ico"><i class="bi bi-basket3"></i></div>
                                <div class="empty-title">Henüz ürün eklenmemiş</div>
                                <p class="empty-sub">Menünüze ilk ürünü ekleyin.</p>
                                <a href="/Product/CreateProduct" class="btn-add" style="display:inline-flex;">
                                    <i class="bi bi-plus-lg"></i> Yeni Ürün Ekle
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var p = Model[i];
                        var sc = p.Status ? "active" : "passive";
                        var sl = p.Status ? "Aktif" : "Pasif";
                        <tr data-name="@p.ProductName.ToLower()"
                            data-desc="@(p.Description?.ToLower() ?? "")"
                            data-cat="@p.CategoryId"
                            data-price="@p.Price"
                            data-status="@sc">
                            <td class="col-num">
                                <span class="row-num">@(i + 1)</span>
                            </td>
                            <td class="col-img">
                                <div class="prod-img">
                                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                    {
                                        <img src="@p.ImageUrl" alt="@p.ProductName" loading="lazy"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                        <span class="prod-img-ph" style="display:none;"><i class="bi bi-image"></i></span>
                                    }
                                    else
                                    {
                                        <span class="prod-img-ph"><i class="bi bi-image"></i></span>
                                    }
                                </div>
                            </td>
                            <td class="col-name">
                                <div class="prod-name">@p.ProductName</div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="prod-desc">@p.Description</div>
                                }
                            </td>
                            <td class="col-cat">
                                <span class="cat-badge">
                                    <i class="bi bi-tag-fill" style="font-size:10px;"></i>
                                    @p.CategoryName
                                </span>
                            </td>
                            <td class="col-price" style="text-align:right;">
                                <span class="price-cell">
                                    <span class="price-currency">₺</span>@p.Price.ToString("N2")
                                </span>
                            </td>
                            <td class="col-status">
                                <span class="s-badge @sc">
                                    <span class="s-dot"></span>@sl
                                </span>
                            </td>
                            <td class="col-act">
                                <div class="act-group">
                                    <a href="/Admin/Product/Detail/@p.ProductId"
                                       class="btn-act view" data-tip="Detay">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>
                                    <a href="/Product/UpdateProduct/@p.ProductId"
                                       class="btn-act edit" data-tip="Düzenle">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    <button class="btn-act del" data-tip="Sil"
                                            onclick="confirmDelete(@p.ProductId, '@p.ProductName')">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <!-- TABLE FOOTER -->
    <div class="tbl-footer">
        <div class="tf-info">
            Toplam <strong id="visibleCount">@total</strong> ürün gösteriliyor
        </div>
        <div class="tf-per">
            <span>Sayfa başına:</span>
            <select class="per-select" id="perPage" onchange="renderPagination()">
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="9999">Tümü</option>
            </select>
        </div>
        <div class="pag" id="pagination"></div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content del-mc">
            <div class="del-mb">
                <div style="width:62px;height:62px;background:#fff5f5;border-radius:50%;
                            display:flex;align-items:center;justify-content:center;
                            margin:0 auto 16px;font-size:24px;color:#ef4444;border:1.5px solid #fecaca;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div class="del-mt">Ürün Silinsin mi?</div>
                <p style="font-size:13.5px;color:#888;margin-bottom:4px;">
                    <strong id="delProdName" style="color:#333;"></strong> adlı ürün kalıcı olarak silinecek.
                </p>
                <p style="font-size:12px;color:#ccc;margin-bottom:0;">Bu işlem geri alınamaz.</p>
            </div>
            <div class="del-mf">
                <button class="btn-cancel-m" type="button" data-bs-dismiss="modal">Vazgeç</button>
                <form asp-controller="Product" asp-action="DeleteProduct" method="post" class="m-0 flex-fill">
                    <input type="hidden" name="id" id="delProductId" value="0" />
                    <button type="submit" class="btn-del-ok w-100">
                        <i class="bi bi-trash3-fill"></i> Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ─── STATE ─────────────────────────────────────── */
        var allRows   = [];
        var filtered  = [];
        var curPage   = 1;
        var sortField = null;
        var sortDir   = 'asc';

        /* ─── INIT ──────────────────────────────────────── */
        document.addEventListener('DOMContentLoaded', function() {
            allRows = Array.from(document.querySelectorAll('#prodBody tr[data-name]'));
            filtered = allRows.slice();
            renderPagination();
            showPage(1);
        });

        /* ─── FILTER ────────────────────────────────────── */
        function filterTable() {
            var q      = document.getElementById('searchInput').value.toLowerCase().trim();
            var cat    = document.getElementById('catFilter').value;
            var status = document.getElementById('statusFilter').value;

            filtered = allRows.filter(function(row) {
                var nm = (row.dataset.name || '').includes(q) || (row.dataset.desc || '').includes(q);
                var cm = cat === 'all' || row.dataset.cat === cat;
                var sm = status === 'all' || row.dataset.status === status;
                return nm && cm && sm;
            });

            /* Re-apply sort */
            if (sortField) applySortToFiltered();

            curPage = 1;
            renderPagination();
            showPage(1);
            updateCounts();
        }

        /* ─── SORT ──────────────────────────────────────── */
        function sortBy(field) {
            if (sortField === field) {
                sortDir = sortDir === 'asc' ? 'desc' : 'asc';
            } else {
                sortField = field; sortDir = 'asc';
            }
            /* Update header icons */
            document.querySelectorAll('.prod-table thead th').forEach(function(th) {
                th.classList.remove('sorted');
                var ico = th.querySelector('.sort-icon');
                if (ico) ico.className = 'bi bi-chevron-expand sort-icon';
            });
            var idx = field === 'name' ? 2 : field === 'cat' ? 3 : 4;
            var th  = document.querySelectorAll('.prod-table thead th')[idx];
            if (th) {
                th.classList.add('sorted');
                var ico = th.querySelector('.sort-icon');
                if (ico) ico.className = 'bi bi-chevron-' + (sortDir === 'asc' ? 'up' : 'down') + ' sort-icon';
            }
            applySortToFiltered();
            curPage = 1;
            renderPagination();
            showPage(1);
        }

        function sortTable() {
            var val = document.getElementById('sortSelect').value;
            if (val === 'default') { sortField = null; filterTable(); return; }
            var parts = val.split('-');
            sortField = parts[0]; sortDir = parts[1];
            applySortToFiltered();
            curPage = 1; renderPagination(); showPage(1);
        }

        function applySortToFiltered() {
            filtered.sort(function(a, b) {
                var av, bv;
                if (sortField === 'name') {
                    av = a.dataset.name; bv = b.dataset.name;
                } else if (sortField === 'price') {
                    av = parseFloat(a.dataset.price); bv = parseFloat(b.dataset.price);
                    return sortDir === 'asc' ? av - bv : bv - av;
                } else if (sortField === 'cat') {
                    av = a.querySelector('.cat-badge') ? a.querySelector('.cat-badge').textContent.trim() : '';
                    bv = b.querySelector('.cat-badge') ? b.querySelector('.cat-badge').textContent.trim() : '';
                } else { return 0; }
                return sortDir === 'asc' ? av.localeCompare(bv, 'tr') : bv.localeCompare(av, 'tr');
            });
        }

        /* ─── PAGINATION ────────────────────────────────── */
        function renderPagination() {
            var per   = parseInt(document.getElementById('perPage').value);
            var pages = per >= 9999 ? 1 : Math.ceil(filtered.length / per);
            var pag   = document.getElementById('pagination');
            if (!pag) return;

            if (pages <= 1) { pag.innerHTML = ''; return; }

            var html = '';
            html += '<button class="pag-btn" ' + (curPage <= 1 ? 'disabled' : '') + ' onclick="goPage(' + (curPage-1) + ')"><i class="bi bi-chevron-left"></i></button>';

            for (var i = 1; i <= pages; i++) {
                if (pages > 7 && i > 2 && i < pages - 1 && Math.abs(i - curPage) > 1) {
                    if (i === 3 || i === pages - 2) html += '<span class="pag-ellipsis">…</span>';
                    continue;
                }
                html += '<button class="pag-btn ' + (i === curPage ? 'active' : '') + '" onclick="goPage(' + i + ')">' + i + '</button>';
            }

            html += '<button class="pag-btn" ' + (curPage >= pages ? 'disabled' : '') + ' onclick="goPage(' + (curPage+1) + ')"><i class="bi bi-chevron-right"></i></button>';
            pag.innerHTML = html;
        }

        function goPage(n) {
            curPage = n; showPage(n); renderPagination();
            document.querySelector('.tbl-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function showPage(n) {
            var per   = parseInt(document.getElementById('perPage').value);
            var start = per >= 9999 ? 0 : (n - 1) * per;
            var end   = per >= 9999 ? filtered.length : start + per;

            allRows.forEach(function(r) { r.style.display = 'none'; });
            filtered.forEach(function(r, i) {
                r.style.display = (i >= start && i < end) ? '' : 'none';
                /* Update row numbers */
                var chip = r.querySelector('.row-num');
                if (chip) chip.textContent = i + 1;
            });

            /* Empty state row */
            var emptyRow = document.querySelector('.empty-row');
            if (emptyRow) emptyRow.style.display = filtered.length === 0 ? '' : 'none';
            if (filtered.length === 0 && !emptyRow) {
                var body = document.getElementById('prodBody');
                var tr   = document.createElement('tr');
                tr.className = 'empty-row temp-empty';
                tr.innerHTML = '<td colspan="7"><div class="empty-inner"><div class="empty-ico"><i class="bi bi-search"></i></div><div class="empty-title">Sonuç bulunamadı</div><p class="empty-sub">Arama veya filtre kriterlerinizi değiştirin.</p></div></td>';
                var existing = body.querySelector('.temp-empty');
                if (existing) existing.remove();
                body.appendChild(tr);
            } else {
                var te = document.querySelector('.temp-empty');
                if (te) te.remove();
            }
        }

        function updateCounts() {
            var vc = document.getElementById('visibleCount');
            if (vc) vc.textContent = filtered.length;
            var rc = document.getElementById('resultCount');
            if (rc) rc.textContent = filtered.length + ' ürün listeleniyor';
        }

        /* ─── DELETE ─────────────────────────────────────── */
        function confirmDelete(id, name) {
            document.getElementById('delProdName').textContent = name;
            document.getElementById('delProductId').value = id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}


