@model GetProductByIdDto

@{
    ViewData["Title"] = "UpdateProduct";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<!-- BREADCRUMB -->
<div class="pg-header">
    <a href="/Product/ProductList/" class="back-btn" title="Geri"><i class="bi bi-arrow-left"></i></a>
    <div style="flex:1;">
        <h1 class="pg-title">
            <i class="bi bi-pencil-square me-2" style="color:var(--accent);font-size:19px;vertical-align:middle;"></i>
            Ürün Düzenle
        </h1>
        <p class="pg-desc">Mevcut ürün bilgilerini güncelleyin.</p>
    </div>
    <div class="id-badge">
        <i class="bi bi-hash"></i> @Model.ProductId
        </div>
    </div>

<!-- FORM -->
<form id="prodForm" asp-action="UpdateProduct" asp-controller="Product"
      asp-route-id="@Model.ProductId"
      method="post" enctype="multipart/form-data" novalidate>

      <input type="hidden" asp-for="ProductId" />

    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="add-layout">

        <!-- ══ LEFT COLUMN ══ -->
        <div>

            <!-- 1. TEMEL BİLGİLER -->
            <div class="f-card">
                <div class="f-card-head">
                    <div class="h-icon"><i class="bi bi-info-circle-fill"></i></div>
                    <div>
                        <div class="h-title">Temel Bilgiler</div>
                        <div class="h-sub">Ürün adı, açıklama ve kategori</div>
                    </div>
                </div>
                <div class="f-card-body">

                    <!-- Ürün Adı -->
                    <div class="form-row">
                        <div class="fg" id="fg-name">
                            <div class="fl">
                                <label for="ProductName">Ürün Adı</label>
                                <span class="lbl-req">* Zorunlu</span>
                            </div>
                            <div class="fi-wrap">
                                <i class="bi bi-basket3-fill fi-ico"></i>
                                <input type="text" id="ProductName" name="ProductName" asp-for="ProductName"
                                       class="f-input f-input-pl f-input-pr"
                                       placeholder="Örn: Izgara Köfte, Limonata..."
                                       maxlength="100" autocomplete="off"
                                       oninput="onName(this)" />
                                <span class="char-count" id="nameCount">0/100</span>
                            </div>
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                            <div class="f-err" id="nameErr"><i class="bi bi-exclamation-circle-fill"></i> Ürün adı zorunludur.</div>
                        </div>
                    </div>

                    <!-- Açıklama -->
                    <div class="form-row">
                        <div class="fg">
                            <div class="fl">
                                <label for="Description">Açıklama</label>
                                <span class="lbl-opt">Opsiyonel</span>
                            </div>
                            <textarea id="Description" name="Description" asp-for="Description"
                                      class="f-textarea"
                                      placeholder="Ürünü kısaca tanımlayın: içindekiler, pişirme yöntemi..."
                                      maxlength="300"
                                      oninput="onDesc(this)"></textarea>
                            <div class="char-count-ta" id="descCount">0/300</div>
                        </div>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <!-- Kategori -->
                    <div class="form-row">
                        <div class="fg" id="fg-cat">
                            <div class="fl">
                                <label for="CategoryId">Kategori</label>
                                <span class="lbl-req">* Zorunlu</span>
                            </div>
                            <div class="fi-wrap">
                                <i class="bi bi-tags-fill fi-ico"></i>
                                <select id="CategoryId" name="CategoryId" asp-for="CategoryId"
                                        class="f-select"
                                        asp-items="ViewBag.Categories"
                                        onchange="onCategory(this)">
                                    <option value="">— Kategori seçin —</option>
                                </select>
                            </div>
                            <span asp-validation-for="CategoryId" class="text-danger"></span>
                            <div class="f-err" id="catErr"><i class="bi bi-exclamation-circle-fill"></i> Lütfen bir kategori seçin.</div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- 2. FİYATLANDIRMA -->
            <div class="f-card">
                <div class="f-card-head">
                    <div class="h-icon"><i class="bi bi-currency-dollar"></i></div>
                    <div>
                        <div class="h-title">Fiyatlandırma</div>
                        <div class="h-sub">Satış fiyatı bilgileri</div>
                    </div>
                </div>
                <div class="f-card-body">
                    <div class="form-row cols-2">

                        <!-- Fiyat -->
                        <div class="fg" id="fg-price">
                            <div class="fl">
                                <label for="Price">Fiyat</label>
                                <span class="lbl-req">* Zorunlu</span>
                            </div>
                            <div class="fi-wrap">
                                <i class="bi bi-cash-coin fi-ico"></i>
                                <input type="number" id="Price" name="Price" asp-for="Price"
                                       class="f-input f-input-pl f-input-pr"
                                       placeholder="0.00" min="0" step="0.01"
                                       oninput="onPrice(this)" />
                                <span class="fi-suf">₺</span>
                            </div>
                            <span asp-validation-for="Price" class="text-danger"></span>
                            <div class="f-err" id="priceErr"><i class="bi bi-exclamation-circle-fill"></i> Geçerli bir fiyat girin.</div>
                            <div class="price-preview" id="pricePreview">
                                <i class="bi bi-tag-fill"></i>
                                <span id="pricePreviewText"></span>
                            </div>
                        </div>

                        <!-- Yayın Durumu -->
                        <div class="fg">
                            <div class="fl"><label>Yayın Durumu</label></div>
                            <div class="st-wrap">
                                <div class="st-opt opt-a">
                                    <input type="radio" name="Status" id="stA" value="true" checked onchange="updateStatus(true)" />
                                    <label for="stA">
                                        <div class="so-ico"><i class="bi bi-check-circle-fill"></i></div>
                                        <div><span class="so-lbl">Aktif</span><span class="so-sub">Menüde görünür</span></div>
                                        <div class="so-chk"><i class="bi bi-check"></i></div>
                                    </label>
                                </div>
                                <div class="st-opt opt-p">
                                    <input type="radio" name="Status" id="stP" value="false" onchange="updateStatus(false)" />
                                    <label for="stP">
                                        <div class="so-ico"><i class="bi bi-pause-circle-fill"></i></div>
                                        <div><span class="so-lbl">Pasif</span><span class="so-sub">Menüde gizli</span></div>
                                        <div class="so-chk"><i class="bi bi-check"></i></div>
                                    </label>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <!-- 3. GÖRSEL -->
            <div class="f-card">
                <div class="f-card-head">
                    <div class="h-icon"><i class="bi bi-image-fill"></i></div>
                    <div>
                        <div class="h-title">Ürün Görseli</div>
                        <div class="h-sub">Dosya yükle veya URL gir</div>
                    </div>
                </div>
                <div class="f-card-body" style="padding-top:0;">

                    <!-- Tabs -->
                    <div class="up-tabs">
                        <div class="utab active" id="tab-btn-upload" onclick="switchTab('upload')">
                            <i class="bi bi-upload me-1"></i> Dosya Yükle
                        </div>
                        <div class="utab" id="tab-btn-url" onclick="switchTab('url')">
                            <i class="bi bi-link-45deg me-1"></i> URL ile Ekle
                        </div>
                    </div>

                    <!-- Upload Panel -->
                    <div class="utab-p active" id="tab-upload">
                        <div class="drop-zone" id="dropZone">
                            <input type="file" id="imgFile" name="ProductImage" accept="image/*" onchange="onFileChange(event)" />
                            <div id="dzDefault">
                                <div class="dz-ico"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                                <div class="dz-title">Görseli sürükleyin veya seçin</div>
                                <p class="dz-sub">veya <span onclick="document.getElementById('imgFile').click()">buraya tıklayın</span><br>PNG, JPG, WEBP — maks. 5MB</p>
                            </div>
                            <div class="dz-prev" id="dzPrev">
                                <img id="dzImg" src="" alt="" />
                                <button type="button" class="dz-rm" onclick="removeImg(event)"><i class="bi bi-x-lg"></i></button>
                            </div>
                        </div>
                        <div class="up-note">
                            <i class="bi bi-shield-check" style="color:var(--green);"></i>
                            Güvenli yükleme &middot; JPG, PNG, WEBP, GIF desteklenir
                        </div>
                    </div>

                    <!-- URL Panel -->
                    <div class="utab-p" id="tab-url">
                        <div class="fg">
                            <div class="fl">
                                <label for="ImageUrl">Görsel URL</label>
                                <span class="lbl-opt">Opsiyonel</span>
                            </div>
                            <div class="fi-wrap">
                                <i class="bi bi-link-45deg fi-ico"></i>
                                <input type="url" id="ImageUrl" name="ImageUrl" asp-for="ImageUrl"
                                       class="f-input f-input-pl"
                                       placeholder="https://ornek.com/gorsel.jpg"
                                       oninput="onUrl(this)" />
                            </div>
                            <span asp-validation-for="ImageUrl" class="text-danger"></span>
                            <div class="f-hint"><i class="bi bi-info-circle"></i>Harici bir görsel bağlantısı girebilirsiniz.</div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- ══ RIGHT COLUMN ══ -->
        <div class="right-col" style="display:flex;flex-direction:column;gap:16px;">

            <!-- Canlı Önizleme -->
            <div class="prev-card">
                <div class="prev-head">
                    <div class="h-icon" style="width:28px;height:28px;font-size:13px;"><i class="bi bi-eye-fill"></i></div>
                    <span class="prev-head-title">Canlı Önizleme</span>
                    <div class="live-dot"></div>
                </div>
                <table class="pci-table">
                    <tr>
                        <td style="width:52px;">
                            <div class="pci-img-sm" id="pciImgWrap">
                                <i class="bi bi-image" id="pciPh"></i>
                                <img id="pciImg" src="" alt="" />
                            </div>
                        </td>
                        <td>
                            <div class="pci-prod-name ph" id="pciName">Ürün adı...</div>
                            <div style="margin-top:3px;">
                                <span class="pci-cat-badge" id="pciCat" style="display:none;">
                                    <i class="bi bi-tag-fill" style="font-size:9px;"></i>
                                    <span id="pciCatText"></span>
                                </span>
                            </div>
                        </td>
                        <td style="text-align:right;white-space:nowrap;">
                            <div class="pci-price ph" id="pciPrice">—</div>
                            <div style="margin-top:4px;">
                                <span class="pci-s-badge active" id="pciStatus">
                                    <span class="pci-sdot"></span>
                                    <span id="pciStatusText">Aktif</span>
                                </span>
                            </div>
                        </td>
                    </tr>
                </table>
                <p class="prev-note">Ürün listesinde bu şekilde görünecek</p>
            </div>

            <!-- Submit -->
            <div class="sub-card">
                <button type="submit" class="btn-sub" id="submitBtn">
                    <i class="bi bi-check-circle-fill"></i>
                    Değişiklikleri Kaydet
                </button>
                <a href="/Admin/Product" class="btn-cancel">
                    <i class="bi bi-x-lg"></i>
                    Vazgeç
                </a>
            </div>

            <!-- Tips -->
            <div class="tips-card">
                <div class="tips-title"><i class="bi bi-lightbulb-fill"></i> İpuçları</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Ürün adını kısa ve net tutun.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Açıklama müşteri kararını etkiler, içindekiler yazın.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Fiyatı KDV dahil olarak girin.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Yüksek kaliteli kare görseller en iyi görünür.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Hazır değilse Pasif olarak kaydedin.</div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
        /* ── NAME ── */
        function onName(el) {
            document.getElementById('nameCount').textContent = el.value.length + '/100';
            var n = document.getElementById('pciName');
            if (el.value.trim()) { n.textContent = el.value; n.classList.remove('ph'); document.getElementById('fg-name').classList.remove('is-invalid'); }
            else { n.textContent = 'Ürün adı...'; n.classList.add('ph'); }
        }

        /* ── DESC ── */
        function onDesc(el) {
            document.getElementById('descCount').textContent = el.value.length + '/300';
        }

        /* ── CATEGORY ── */
        function onCategory(el) {
            var txt = el.options[el.selectedIndex]?.text;
            var catEl  = document.getElementById('pciCat');
            var catTxt = document.getElementById('pciCatText');
            if (el.value && el.value !== '') {
                catEl.style.display = 'inline-flex';
                catTxt.textContent  = txt;
                document.getElementById('fg-cat').classList.remove('is-invalid');
            } else {
                catEl.style.display = 'none';
            }
        }

        /* ── PRICE ── */
        function onPrice(el) {
            var v   = parseFloat(el.value);
            var pp  = document.getElementById('pricePreview');
            var ppt = document.getElementById('pricePreviewText');
            var pci = document.getElementById('pciPrice');
            if (!isNaN(v) && v >= 0) {
                var fmt = v.toLocaleString('tr-TR', { minimumFractionDigits:2, maximumFractionDigits:2 });
                pp.classList.add('show');
                ppt.textContent = '₺' + fmt;
                pci.textContent = '₺' + fmt;
                pci.classList.remove('ph');
                document.getElementById('fg-price').classList.remove('is-invalid');
            } else {
                pp.classList.remove('show');
                pci.textContent = '—'; pci.classList.add('ph');
            }
        }

        /* ── STATUS ── */
        function updateStatus(active) {
            var b = document.getElementById('pciStatus');
            b.className = 'pci-s-badge ' + (active ? 'active' : 'passive');
            document.getElementById('pciStatusText').textContent = active ? 'Aktif' : 'Pasif';
        }

        /* ── IMAGE UPLOAD ── */
        var dz = document.getElementById('dropZone');
        dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.classList.add('over'); });
        dz.addEventListener('dragleave', function() { dz.classList.remove('over'); });
        dz.addEventListener('drop', function(e) {
            e.preventDefault(); dz.classList.remove('over');
            var f = e.dataTransfer.files[0];
            if (f && f.type.startsWith('image/')) readFile(f);
        });

        function onFileChange(e) { if (e.target.files[0]) readFile(e.target.files[0]); }

        function readFile(file) {
            var r = new FileReader();
            r.onload = function(e) { setPreview(e.target.result); };
            r.readAsDataURL(file);
        }

        function setPreview(src) {
            document.getElementById('dzImg').src = src;
            document.getElementById('dzDefault').style.display = 'none';
            document.getElementById('dzPrev').style.display    = 'block';
            var img = document.getElementById('pciImg');
            img.src = src; img.style.display = 'block';
            document.getElementById('pciPh').style.display = 'none';
        }

        function removeImg(e) {
            e.stopPropagation();
            document.getElementById('dzImg').src = '';
            document.getElementById('dzDefault').style.display = '';
            document.getElementById('dzPrev').style.display    = 'none';
            document.getElementById('imgFile').value           = '';
            var img = document.getElementById('pciImg');
            img.src = ''; img.style.display = 'none';
            document.getElementById('pciPh').style.display = '';
        }

        /* ── URL PREVIEW ── */
        var urlTimer;
        function onUrl(el) {
            clearTimeout(urlTimer);
            urlTimer = setTimeout(function() {
                var url = el.value.trim();
                if (url) { var i = new Image(); i.onload = function() { setPreview(url); }; i.src = url; }
            }, 600);
        }

        /* ── TAB SWITCH ── */
        function switchTab(tab) {
            document.getElementById('tab-btn-upload').classList.toggle('active', tab === 'upload');
            document.getElementById('tab-btn-url').classList.toggle('active', tab === 'url');
            document.getElementById('tab-upload').classList.toggle('active', tab === 'upload');
            document.getElementById('tab-url').classList.toggle('active', tab === 'url');
        }

        /* ── SUBMIT VALIDATION ── */
        document.getElementById('prodForm').addEventListener('submit', function(e) {
            var valid = true;

            var name = document.getElementById('ProductName').value.trim();
            if (!name) {
                document.getElementById('fg-name').classList.add('is-invalid');
                if (valid) document.getElementById('ProductName').focus();
                valid = false;
            }

            var cat = document.getElementById('CategoryId').value;
            if (!cat) {
                document.getElementById('fg-cat').classList.add('is-invalid');
                if (valid) document.getElementById('CategoryId').focus();
                valid = false;
            }

            var price = document.getElementById('Price').value;
            if (!price || isNaN(parseFloat(price)) || parseFloat(price) < 0) {
                document.getElementById('fg-price').classList.add('is-invalid');
                if (valid) document.getElementById('Price').focus();
                valid = false;
            }

            if (!valid) { e.preventDefault(); return; }

            var btn = document.getElementById('submitBtn');
            btn.classList.add('loading');
            btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Kaydediliyor...';
        });
    </script>
}


