@model UpdateReviewDto

@{
    ViewData["Title"] = "UpdateReview";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@* Ürün listesi için - Controller'dan ViewBag ile geçirilecek *@
@* ViewBag.Products = SelectList *@
<!-- ── PAGE HEADER ── -->
<div class="pg-header">
    <div>
        <h1 class="pg-title">
            <i class="bi bi-pencil-fill me-2" style="color:var(--accent);font-size:20px;vertical-align:middle;"></i>
            Değerlendirme Düzenle
        </h1>
        <p class="pg-desc">Mevcut müşteri değerlendirmesini güncelleyin.</p>
    </div>
    <a href="/Review/ReviewList/" class="btn-back">
        <i class="bi bi-arrow-left"></i>
        Listeye Dön
    </a>
</div>

<form asp-action="UpdateReview" asp-route-id="@Model.ReviewId" method="post" id="reviewForm" novalidate>
    <input type="hidden" asp-for="ReviewId" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-layout">

        <!-- ═══════════ SOL KOLON ═══════════ -->
        <div>

            <!-- MÜŞTERİ BİLGİSİ -->
            <div class="form-card">
                <div class="card-header">
                    <div class="card-header-icon" style="background:var(--accent-soft);">
                        <i class="bi bi-person-fill" style="color:var(--accent-dark);"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Müşteri Bilgisi</p>
                        <p class="card-header-sub">Değerlendirmeyi yapan kişinin adı.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-row single">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-person"></i> Müşteri Adı <span class="req">*</span>
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-person i-icon"></i>
                                <input asp-for="CustomerName" class="form-control"
                                       placeholder="Ahmet Yılmaz"
                                       id="inpCustomer" oninput="updateSummary()" />
                            </div>
                            <span asp-validation-for="CustomerName" class="field-error">
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ÜRÜN SEÇİMİ -->
            <div class="form-card">
                <div class="card-header">
                    <div class="card-header-icon" style="background:rgba(59,130,246,0.10);">
                        <i class="bi bi-basket3-fill" style="color:#3b82f6;"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Ürün Seçimi</p>
                        <p class="card-header-sub">Değerlendirme yapılacak ürünü seçin.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-row single">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-basket3"></i> Ürün <span class="req">*</span>
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-basket3 i-icon"></i>
                                <select asp-for="ProductId"
                                        asp-items="ViewBag.Products"
                                        class="form-control"
                                        id="inpProduct"
                                        onchange="updateSummary()">
                                    <option value="">— Ürün Seçin —</option>
                                </select>
                            </div>
                            <span asp-validation-for="ProductId" class="field-error">
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PUAN VE YORUM -->
            <div class="form-card">
                <div class="card-header">
                    <div class="card-header-icon" style="background:rgba(245,158,11,0.10);">
                        <i class="bi bi-star-fill" style="color:#f59e0b;"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Puan & Yorum</p>
                        <p class="card-header-sub">Yıldız puanı ve detaylı yorum giriniz.</p>
                    </div>
                </div>
                <div class="card-body">

                    <!-- STAR RATING -->
                    <div class="form-group" style="margin-bottom:20px;">
                        <label class="form-label">
                            <i class="bi bi-star"></i> Puan <span class="req">*</span>
                        </label>
                        <div class="star-rating-wrap">
                            <div class="stars">
                                <input type="radio" asp-for="Rating" id="s5" value="5" onchange="onStarChange(5)" />
                                <label for="s5" title="Mükemmel">★</label>
                                <input type="radio" asp-for="Rating" id="s4" value="4" onchange="onStarChange(4)" />
                                <label for="s4" title="Çok İyi">★</label>
                                <input type="radio" asp-for="Rating" id="s3" value="3" onchange="onStarChange(3)" />
                                <label for="s3" title="İyi">★</label>
                                <input type="radio" asp-for="Rating" id="s2" value="2" onchange="onStarChange(2)" />
                                <label for="s2" title="Orta">★</label>
                                <input type="radio" asp-for="Rating" id="s1" value="1" onchange="onStarChange(1)" />
                                <label for="s1" title="Kötü">★</label>
                            </div>
                            <div class="star-hint" id="starHint">Bir puan seçin...</div>
                            <div class="star-labels">
                                <span class="star-chip" onclick="setRating(1)">★ Kötü</span>
                                <span class="star-chip" onclick="setRating(2)">★★ Orta</span>
                                <span class="star-chip" onclick="setRating(3)">★★★ İyi</span>
                                <span class="star-chip" onclick="setRating(4)">★★★★ Çok İyi</span>
                                <span class="star-chip" onclick="setRating(5)">★★★★★ Mükemmel</span>
                            </div>
                        </div>
                        <span asp-validation-for="Rating" class="field-error">
                        </span>
                    </div>

                    <!-- YORUM -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="bi bi-chat-square-text"></i> Yorum <span class="req">*</span>
                        </label>
                        <div class="input-wrap textarea-wrap">
                            <i class="bi bi-chat-square-dots i-icon"></i>
                            <textarea asp-for="Comment" class="form-control"
                                      placeholder="Ürün hakkındaki düşüncelerinizi paylaşın..."
                                      rows="4" id="inpComment" oninput="updateSummary()"></textarea>
                        </div>
                        <span asp-validation-for="Comment" class="field-error">
                        </span>
                    </div>

                </div>
            </div>

        </div>

        <!-- ═══════════ SAĞ KOLON ═══════════ -->
        <div>

            <!-- ÖZET -->
            <div class="summary-card" style="margin-bottom:16px;">
                <div class="summary-title">
                    <i class="bi bi-receipt"></i> Değerlendirme Özeti
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-person-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Müşteri</div>
                        <div class="sr-val" id="sumCustomer">—</div>
                    </div>
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-basket3-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Ürün</div>
                        <div class="sr-val" id="sumProduct">—</div>
                    </div>
                </div>

                <hr class="summary-divider" />

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-star-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Puan</div>
                        <div class="sr-val" id="sumStars">
                            <span class="sum-stars empty">★★★★★</span>
                        </div>
                    </div>
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-chat-square-text-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Yorum</div>
                        <div class="sr-val" id="sumComment" style="font-style:italic;font-size:12px;line-height:1.5;">—</div>
                    </div>
                </div>

                <hr class="summary-divider" />

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-shield-check"></i></div>
                    <div>
                        <div class="sr-lbl">Durum</div>
                        <div class="sr-val" id="sumStatus">Yayında</div>
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="bi bi-check-lg"></i>
                    Değişiklikleri Kaydet
                </button>

                <a href="/Review/ReviewList/" class="btn-cancel-form">
                    <i class="bi bi-x-lg"></i> Vazgeç
                </a>
            </div>

            <!-- PUAN DAĞILIMI REHBERİ -->
            <div class="form-card">
                <div class="card-header">
                    <div class="card-header-icon" style="background:rgba(245,158,11,0.10);">
                        <i class="bi bi-bar-chart-fill" style="color:#f59e0b;"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Puan Rehberi</p>
                        <p class="card-header-sub">Ne anlama gelir?</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="rating-dist">
                        <div class="rd-row">
                            <span class="rd-label" style="color:var(--accent);">5</span>
                            <div class="rd-bar-wrap"><div class="rd-bar" style="width:100%;"></div></div>
                            <span class="rd-count" style="color:var(--accent);">Mükemmel</span>
                        </div>
                        <div class="rd-row">
                            <span class="rd-label">4</span>
                            <div class="rd-bar-wrap"><div class="rd-bar" style="width:80%;background:#22c55e;"></div></div>
                            <span class="rd-count">Çok İyi</span>
                        </div>
                        <div class="rd-row">
                            <span class="rd-label">3</span>
                            <div class="rd-bar-wrap"><div class="rd-bar" style="width:60%;background:#3b82f6;"></div></div>
                            <span class="rd-count">İyi</span>
                        </div>
                        <div class="rd-row">
                            <span class="rd-label">2</span>
                            <div class="rd-bar-wrap"><div class="rd-bar" style="width:40%;background:#f59e0b;"></div></div>
                            <span class="rd-count">Orta</span>
                        </div>
                        <div class="rd-row">
                            <span class="rd-label">1</span>
                            <div class="rd-bar-wrap"><div class="rd-bar" style="width:20%;background:#ef4444;"></div></div>
                            <span class="rd-count">Kötü</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var currentRating = 0;

        var starHints = {
            1: '★ Kötü — Beklentileri karşılamadı.',
            2: '★★ Orta — Geliştirilmesi gerekiyor.',
            3: '★★★ İyi — Yeterli, ama daha iyi olabilir.',
            4: '★★★★ Çok İyi — Memnun kaldım!',
            5: '★★★★★ Mükemmel — Harika bir deneyim!'
        };

        /* ── STAR CHANGE ── */
        function onStarChange(val) {
            currentRating = val;
            document.getElementById('starHint').textContent = starHints[val];

            // Chip'leri güncelle
            document.querySelectorAll('.star-chip').forEach(function(c, i) {
                c.classList.toggle('active', i + 1 === val);
            });

            updateSummary();
        }

        function setRating(val) {
            document.getElementById('s' + val).checked = true;
            onStarChange(val);
        }

        /* ── LIVE SUMMARY ── */
        function updateSummary() {
            // Müşteri
            var customer = (document.getElementById('inpCustomer').value || '').trim();
            document.getElementById('sumCustomer').textContent = customer || '—';

            // Ürün
            var productEl = document.getElementById('inpProduct');
            var productText = productEl.options[productEl.selectedIndex]?.text || '—';
            document.getElementById('sumProduct').textContent =
                productEl.value ? productText : '—';

            // Puan (yıldız)
            var starsEl = document.getElementById('sumStars');
            if (currentRating > 0) {
                var filled = '★'.repeat(currentRating);
                var empty  = '★'.repeat(5 - currentRating);
                starsEl.innerHTML =
                    '<span class="sum-stars">' + filled + '</span>' +
                    '<span class="sum-stars empty">' + empty + '</span>' +
                    ' <span style="font-size:11px;color:rgba(255,255,255,0.4);margin-left:4px;">' + currentRating + '/5</span>';
            } else {
                starsEl.innerHTML = '<span class="sum-stars empty">★★★★★</span>';
            }

            // Yorum
            var comment = (document.getElementById('inpComment').value || '').trim();
            var sumComment = document.getElementById('sumComment');
            if (comment) {
                sumComment.textContent = comment.length > 60 ? comment.substring(0, 60) + '...' : comment;
            } else {
                sumComment.textContent = '—';
            }

            // Durum — edit form does not change publication status
            document.getElementById('sumStatus').textContent = 'Mevcut durum korunur';
        }

        // Chip hover label
        document.querySelectorAll('.star-chip').forEach(function(chip, i) {
            chip.addEventListener('mouseenter', function() {
                if (currentRating === 0) {
                    document.getElementById('starHint').textContent = starHints[i + 1];
                }
            });
            chip.addEventListener('mouseleave', function() {
                document.getElementById('starHint').textContent =
                    currentRating > 0 ? starHints[currentRating] : 'Bir puan seçin...';
            });
        });

        // Existing rating + summary
        document.addEventListener('DOMContentLoaded', function() {
            var initial = @Model.Rating;
            if (initial >= 1 && initial <= 5) {
                setRating(initial);
            }
            updateSummary();
        });
    </script>
}

