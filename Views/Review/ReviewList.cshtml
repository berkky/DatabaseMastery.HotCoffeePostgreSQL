@model List<ResultReviewDto>

@{
    ViewData["Title"] = "ReviewList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var total = Model?.Count ?? 0;
    var active = Model?.Count(r => r.Status) ?? 0;
    var passive = total - active;
    var avgRating = Model?.Any() == true ? Model.Average(r => r.Rating) : 0;
    var fiveStar = Model?.Count(r => r.Rating == 5) ?? 0;
}
<partial name="_AdminFlashMessagesPartial" />

<!-- ── PAGE HEADER ── -->
<div class="pg-header">
    <div>
        <h1 class="pg-title">
            <i class="bi bi-star-fill me-2" style="color:var(--accent);font-size:20px;vertical-align:middle;"></i>
            Değerlendirme Yönetimi
        </h1>
        <p class="pg-desc">Müşteri yorumlarını görüntüleyin ve yönetin.</p>
    </div>
    <a href="/Review/CreateReview/" class="btn-add">
        <i class="bi bi-plus-lg"></i>
        Yeni Değerlendirme
    </a>
</div>

<!-- ── STAT CARDS ── -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-icon" style="background:#f5f2ee;">
            <i class="bi bi-star-half" style="color:#aaa;"></i>
        </div>
        <div>
            <div class="stat-num">@total</div>
            <div class="stat-lbl">Toplam Yorum</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--green-soft);">
            <i class="bi bi-eye-fill" style="color:var(--green);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#16a34a;">@active</div>
            <div class="stat-lbl">Yayında</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--accent-soft);">
            <i class="bi bi-star-fill" style="color:var(--accent);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:var(--accent-dark);">@avgRating.ToString("F1")</div>
            <div class="stat-lbl">Ortalama Puan</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-icon" style="background:var(--yellow-soft);">
            <i class="bi bi-trophy-fill" style="color:var(--yellow);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#b45309;">@fiveStar</div>
            <div class="stat-lbl">5 Yıldızlı Yorum</div>
        </div>
    </div>
</div>

<!-- ── RATING OVERVIEW ── -->
@if (Model != null && Model.Any())
{
    var avg = Model.Average(r => r.Rating);
    var dist = Enumerable.Range(1, 5).ToDictionary(
        s => s,
        s => Model.Count(r => r.Rating == s)
    );
    var maxDist = dist.Values.Max() == 0 ? 1 : dist.Values.Max();

    <div class="rating-overview">
        <div class="ro-score">
            <div class="ro-num">@avg.ToString("F1")</div>
            <div class="ro-stars">
                @for (int i = 1; i <= 5; i++)
                {
                    <span style="color:@(i <= Math.Round(avg) ? "var(--accent)" : "rgba(255,255,255,0.15)");">★</span>
                }
            </div>
            <div class="ro-total">@total yorum</div>
        </div>

        <div class="ro-divider"></div>

        <div class="ro-bars">
            @for (int s = 5; s >= 1; s--)
            {
                var cnt = dist[s];
                var pct = total > 0 ? (cnt * 100 / total) : 0;
                <div class="ro-bar-row">
                    <span class="ro-bar-label">@s</span>
                    <div class="ro-bar-wrap">
                        <div class="ro-bar-fill" style="width:@pct%;"></div>
                    </div>
                    <span class="ro-bar-count">@cnt</span>
                </div>
            }
        </div>

        <div class="ro-divider"></div>

        <div class="ro-stats">
            <div class="ro-stat">
                <div class="ro-stat-num" style="color:var(--green);">@active</div>
                <div class="ro-stat-lbl">Yayında</div>
            </div>
            <div class="ro-stat">
                <div class="ro-stat-num" style="color:var(--red);">@passive</div>
                <div class="ro-stat-lbl">Gizli</div>
            </div>
            <div class="ro-stat">
                <div class="ro-stat-num" style="color:var(--accent);">@fiveStar</div>
                <div class="ro-stat-lbl">5 Yıldız</div>
            </div>
        </div>
    </div>
}

<!-- ── TOOLBAR ── -->
<div class="toolbar">
    <div class="search-wrap">
        <i class="bi bi-search si"></i>
        <input type="text" class="search-input" id="searchInput"
               placeholder="Müşteri adı veya yorum ara..."
               oninput="filterTable()" />
    </div>
    <select class="f-select" id="statusFilter" onchange="filterTable()">
        <option value="all">Tüm Durumlar</option>
        <option value="active">Yayında</option>
        <option value="passive">Gizli</option>
    </select>
    <select class="f-select" id="ratingFilter" onchange="filterTable()">
        <option value="all">Tüm Puanlar</option>
        <option value="5">★★★★★ Mükemmel</option>
        <option value="4">★★★★ Çok İyi</option>
        <option value="3">★★★ İyi</option>
        <option value="2">★★ Orta</option>
        <option value="1">★ Kötü</option>
    </select>
    <select class="f-select" id="sortSelect" onchange="sortTable()">
        <option value="default">Sıralama</option>
        <option value="rating-desc">Puan ↓</option>
        <option value="rating-asc">Puan ↑</option>
        <option value="date-desc">Tarih ↓</option>
        <option value="date-asc">Tarih ↑</option>
        <option value="name-asc">Ad A→Z</option>
    </select>
    <div class="toolbar-right">
        <span class="result-count" id="resultCount">@total yorum</span>
    </div>
</div>

<!-- ── TABLE CARD ── -->
<div class="tbl-card">
    <div style="overflow-x:auto;">
        <table class="rev-table" id="revTable">
            <thead>
                <tr>
                    <th class="col-num no-sort">#</th>
                    <th class="col-customer" onclick="sortBy('name')">Müşteri <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="col-product no-sort">Ürün</th>
                    <th class="col-rating" onclick="sortBy('rating')">Puan <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="col-comment no-sort">Yorum</th>
                    <th class="col-date" onclick="sortBy('date')">Tarih <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="col-status no-sort">Durum</th>
                    <th class="col-act no-sort">İşlem</th>
                </tr>
            </thead>
            <tbody id="revBody">

                @if (Model == null || !Model.Any())
                {
                    <tr class="empty-row">
                        <td colspan="8">
                            <div class="empty-inner">
                                <div class="empty-ico"><i class="bi bi-star"></i></div>
                                <div style="font-family:'Playfair Display',serif;font-size:16px;font-weight:700;color:#333;margin-bottom:6px;">Henüz değerlendirme yok</div>
                                <p style="font-size:13px;color:#bbb;margin-bottom:18px;">İlk müşteri değerlendirmesini ekleyin.</p>
                                <a href="/Review/CreateReview/" class="btn-add" style="display:inline-flex;">
                                    <i class="bi bi-plus-lg"></i> Yeni Değerlendirme
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    var avatarColors = new[] { "#e6a03c", "#3b82f6", "#22c55e", "#8b5cf6", "#14b8a6", "#ef4444", "#f59e0b" };

                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var r = Model[i];
                        var sc = r.Status ? "active" : "passive";
                        var sl = r.Status ? "Yayında" : "Gizli";
                        var initials = string.Join("", r.CustomerName.Split(' ').Take(2).Select(w => w[0].ToString().ToUpper()));
                        var avatarColor = avatarColors[i % avatarColors.Length];
                        var filledStars = new string('★', r.Rating);
                        var emptyStars = new string('★', 5 - r.Rating);

                        <tr data-name="@r.CustomerName.ToLower()"
                            data-comment="@(r.Comment?.ToLower() ?? "")"
                            data-rating="@r.Rating"
                            data-status="@sc"
                            data-date="@r.CreatedAt.ToString("yyyy-MM-dd")">
                            <td class="col-num"><span class="row-num">@(i + 1)</span></td>
                            <td class="col-customer">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="customer-avatar" style="background:@avatarColor;">@initials</div>
                                    <span class="customer-name">@r.CustomerName</span>
                                </div>
                            </td>
                            <td class="col-product">
                                <span class="product-badge">
                                    <i class="bi bi-basket3-fill" style="font-size:10px;"></i>
                                    @r.ProductName
                                </span>
                            </td>
                            <td class="col-rating">
                                <div class="star-display">
                                    <span class="stars-filled">@filledStars</span>
                                    <span class="stars-empty">@emptyStars</span>
                                    <span class="rating-num">@r.Rating/5</span>
                                </div>
                            </td>
                            <td class="col-comment">
                                @if (!string.IsNullOrWhiteSpace(r.Comment))
                                {
                                    <span class="comment-text" title="@r.Comment">@r.Comment</span>
                                }
                                else
                                {
                                    <span style="font-size:12px;color:#ddd;">—</span>
                                }
                            </td>
                            <td class="col-date">
                                <span class="date-cell">@TurkishDatePresentation.FormatDateTime(r.CreatedAt)</span>
                            </td>
                            <td class="col-status">
                                <span class="s-badge @(r.Status ? "sb-active" : "sb-passive")">
                                    <span class="s-dot"></span>@sl
                                </span>
                            </td>
                            <td class="col-act">
                                <div class="act-group">
                                    <a asp-action="UpdateReview" asp-route-id="@r.ReviewId"
                                       class="btn-act edit" data-tip="Düzenle">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>
                                    @if (r.Status)
                                    {
                                        <form asp-action="HideReview" asp-route-id="@r.ReviewId" method="post" class="m-0 d-inline">
                                            <button type="submit" class="btn-act toggle-on" data-tip="Gizle">
                                                <i class="bi bi-eye-slash-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="PublishReview" asp-route-id="@r.ReviewId" method="post" class="m-0 d-inline">
                                            <button type="submit" class="btn-act toggle-off" data-tip="Yayınla">
                                                <i class="bi bi-eye-fill"></i>
                                            </button>
                                        </form>
                                    }
                                    <button type="button" class="btn-act del" data-tip="Sil"
                                            onclick="confirmDelete(@r.ReviewId, '@r.CustomerName.Replace("'", "\\'")')">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <div class="tbl-footer">
        <div class="tf-info">Toplam <strong id="visibleCount">@total</strong> yorum gösteriliyor</div>
        <div class="pag" id="pagination"></div>
    </div>
</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content del-mc">
            <div class="del-mb">
                <div style="width:62px;height:62px;background:#fff5f5;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;font-size:24px;color:#ef4444;border:1.5px solid #fecaca;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div class="del-mt">Yorum Silinsin mi?</div>
                <p style="font-size:13.5px;color:#888;margin-bottom:4px;">
                    <strong id="delName" style="color:#333;"></strong> adlı müşterinin yorumu kalıcı olarak silinecek.
                </p>
                <p style="font-size:12px;color:#ccc;margin-bottom:0;">Bu işlem geri alınamaz.</p>
            </div>
            <div class="del-mf">
                <button class="btn-cancel-m" type="button" data-bs-dismiss="modal">Vazgeç</button>
                <form asp-controller="Review" asp-action="DeleteReview" method="post" class="m-0 flex-fill">
                    <input type="hidden" name="id" id="delReviewId" value="0" />
                    <button type="submit" class="btn-del-ok w-100">
                        <i class="bi bi-trash3-fill"></i> Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var allRows  = [];
        var filtered = [];
        var curPage  = 1;
        var perPage  = 20;
        var sortField = null;
        var sortDir   = 'asc';

        document.addEventListener('DOMContentLoaded', function () {
            allRows  = Array.from(document.querySelectorAll('#revBody tr[data-name]'));
            filtered = allRows.slice();
            renderPagination();
            showPage(1);
        });

        function filterTable() {
            var q      = document.getElementById('searchInput').value.toLowerCase().trim();
            var status = document.getElementById('statusFilter').value;
            var rating = document.getElementById('ratingFilter').value;

            filtered = allRows.filter(function (row) {
                var nm = (row.dataset.name    || '').includes(q) ||
                         (row.dataset.comment || '').includes(q);
                var sm = status === 'all' || row.dataset.status === status;
                var rm = rating === 'all' || row.dataset.rating === rating;
                return nm && sm && rm;
            });

            if (sortField) applySortToFiltered();
            curPage = 1; renderPagination(); showPage(1); updateCounts();
        }

        function sortBy(field) {
            if (sortField === field) { sortDir = sortDir === 'asc' ? 'desc' : 'asc'; }
            else { sortField = field; sortDir = 'asc'; }

            document.querySelectorAll('.rev-table thead th').forEach(function (th) {
                th.classList.remove('sorted');
                var ico = th.querySelector('.sort-icon');
                if (ico) ico.className = 'bi bi-chevron-expand sort-icon';
            });

            var colMap = { name: 1, rating: 3, date: 5 };
            var th = document.querySelectorAll('.rev-table thead th')[colMap[field]];
            if (th) {
                th.classList.add('sorted');
                var ico = th.querySelector('.sort-icon');
                if (ico) ico.className = 'bi bi-chevron-' + (sortDir === 'asc' ? 'up' : 'down') + ' sort-icon';
            }

            applySortToFiltered();
            curPage = 1; renderPagination(); showPage(1);
        }

        function sortTable() {
            var val = document.getElementById('sortSelect').value;
            if (val === 'default') { sortField = null; filterTable(); return; }
            var parts = val.split('-');
            sortField = parts[0]; sortDir = parts[1];
            applySortToFiltered();
            curPage = 1; renderPagination(); showPage(1);
        }

        function applySortToFiltered() {
            filtered.sort(function (a, b) {
                if (sortField === 'name') {
                    var av = a.dataset.name, bv = b.dataset.name;
                    return sortDir === 'asc' ? av.localeCompare(bv,'tr') : bv.localeCompare(av,'tr');
                }
                if (sortField === 'rating') {
                    var av = parseInt(a.dataset.rating), bv = parseInt(b.dataset.rating);
                    return sortDir === 'asc' ? av - bv : bv - av;
                }
                if (sortField === 'date') {
                    var av = new Date(a.dataset.date), bv = new Date(b.dataset.date);
                    return sortDir === 'asc' ? av - bv : bv - av;
                }
                return 0;
            });
        }

        function renderPagination() {
            var pages = Math.ceil(filtered.length / perPage);
            var pag   = document.getElementById('pagination');
            if (!pag || pages <= 1) { if(pag) pag.innerHTML=''; return; }

            var html = '<button class="pag-btn" ' + (curPage<=1?'disabled':'') + ' onclick="goPage('+(curPage-1)+')"><i class="bi bi-chevron-left"></i></button>';
            for (var i = 1; i <= pages; i++) {
                if (pages > 7 && i > 2 && i < pages-1 && Math.abs(i-curPage) > 1) {
                    if (i===3||i===pages-2) html += '<span style="display:flex;align-items:center;justify-content:center;width:32px;color:#bbb;">…</span>';
                    continue;
                }
                html += '<button class="pag-btn '+(i===curPage?'active':'')+'" onclick="goPage('+i+')">'+i+'</button>';
            }
            html += '<button class="pag-btn" '+(curPage>=pages?'disabled':'')+' onclick="goPage('+(curPage+1)+')"><i class="bi bi-chevron-right"></i></button>';
            pag.innerHTML = html;
        }

        function goPage(n) {
            curPage = n; showPage(n); renderPagination();
            document.querySelector('.tbl-card').scrollIntoView({ behavior:'smooth', block:'start' });
        }

        function showPage(n) {
            var start = (n-1)*perPage, end = start+perPage;
            allRows.forEach(function(r){ r.style.display='none'; });
            filtered.forEach(function(r,i){
                r.style.display = (i>=start && i<end) ? '' : 'none';
                var chip = r.querySelector('.row-num');
                if(chip) chip.textContent = i+1;
            });

            var empty = document.querySelector('.empty-row');
            if(empty) empty.style.display = filtered.length===0 ? '' : 'none';
            if(filtered.length===0 && !empty){
                var body = document.getElementById('revBody');
                var te = body.querySelector('.temp-empty');
                if(te) te.remove();
                var tr = document.createElement('tr');
                tr.className='empty-row temp-empty';
                tr.innerHTML='<td colspan="8"><div class="empty-inner"><div class="empty-ico"><i class="bi bi-search"></i></div><div style="font-family:\'Playfair Display\',serif;font-size:15px;font-weight:700;color:#333;margin-bottom:6px;">Sonuç bulunamadı</div><p style="font-size:13px;color:#bbb;">Filtre veya arama kriterlerinizi değiştirin.</p></div></td>';
                body.appendChild(tr);
            } else {
                var te = document.querySelector('.temp-empty');
                if(te) te.remove();
            }
        }

        function updateCounts() {
            var vc = document.getElementById('visibleCount');
            if(vc) vc.textContent = filtered.length;
            var rc = document.getElementById('resultCount');
            if(rc) rc.textContent = filtered.length + ' yorum';
        }

        function confirmDelete(id, name) {
            document.getElementById('delName').textContent = name;
            document.getElementById('delReviewId').value = id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}

