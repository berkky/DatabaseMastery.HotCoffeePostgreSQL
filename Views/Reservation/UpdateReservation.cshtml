@model GetReservationByIdDto
@using DatabaseMastery.HotCoffeePostgreSQL.Domain

@{
    ViewData["Title"] = "UpdateReservation";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var displayStatus = ReservationStatusPresentation.GetDisplayName(Model.Status);
}
<!-- ── PAGE HEADER ── -->
<div class="pg-header">
    <div>
        <h1 class="pg-title">
            <i class="bi bi-calendar2-plus-fill me-2" style="color:var(--accent);font-size:20px;vertical-align:middle;"></i>
            Rezervasyon Düzenle
        </h1>
        <p class="pg-desc">Mevcut bir rezervasyonu düzenleyin.</p>
    </div>
    <a href="/Reservation/ReservationList/" class="btn-back">
        <i class="bi bi-arrow-left"></i>
        Listeye Dön
    </a>
</div>

<form asp-action="UpdateReservation" asp-route-id="@Model.ReservationId" method="post" id="resForm" novalidate>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-layout">
        

        <input type="hidden" asp-for="ReservationId" />

        <!-- ═══════════════════ SOL KOLON ═══════════════════ -->
        <div>

            <!-- MÜŞTERİ BİLGİLERİ -->
            <div class="form-card" style="margin-bottom:18px;">
                <div class="card-header">
                    <div class="card-header-icon" style="background:var(--accent-soft);">
                        <i class="bi bi-person-fill" style="color:var(--accent-dark);"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Müşteri Bilgileri</p>
                        <p class="card-header-sub">Ad, iletişim ve e-posta bilgilerini girin.</p>
                    </div>
                </div>
                <div class="card-body">

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-person"></i> Ad Soyad <span class="req">*</span>
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-person i-icon"></i>
                                <input asp-for="Name" class="form-control" placeholder="Ahmet Yılmaz" id="inpName" oninput="updateSummary()" />
                            </div>
                            <span asp-validation-for="Name" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-telephone"></i> Telefon <span class="req">*</span>
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-telephone i-icon"></i>
                                <input asp-for="Phone" class="form-control" placeholder="0532 000 00 00"
                                       id="inpPhone" oninput="updateSummary()" />
                            </div>
                            <span asp-validation-for="Phone" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-row single">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-envelope"></i> E-posta
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-envelope i-icon"></i>
                                <input asp-for="Email" class="form-control" placeholder="ornek@mail.com" type="email" />
                            </div>
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- REZERVASYON DETAYLARI -->
            <div class="form-card" style="margin-bottom:18px;">
                <div class="card-header">
                    <div class="card-header-icon" style="background:var(--blue-soft,rgba(59,130,246,0.10));">
                        <i class="bi bi-calendar2-check" style="color:#3b82f6;"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Rezervasyon Detayları</p>
                        <p class="card-header-sub">Tarih, saat ve kişi sayısını belirleyin.</p>
                    </div>
                </div>
                <div class="card-body">

                    <div class="form-row">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-calendar3"></i> Tarih <span class="req">*</span>
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-calendar3 i-icon"></i>
                                <input asp-for="ReservationDate" type="date" class="form-control"
                                       id="inpDate" oninput="updateSummary()" />
                            </div>
                            <span asp-validation-for="ReservationDate" class="field-error"></span>
                        </div>
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-clock"></i> Saat <span class="req">*</span>
                            </label>
                            <div class="input-wrap">
                                <i class="bi bi-clock i-icon"></i>
                                <input asp-for="ReservationTime" type="time" class="form-control"
                                       id="inpTime" oninput="updateSummary()" />
                            </div>
                            <span asp-validation-for="ReservationTime" class="field-error"></span>
                        </div>
                    </div>

                    <div class="form-row single">
                        <div class="form-group">
                            <label class="form-label">
                                <i class="bi bi-people"></i> Kişi Sayısı <span class="req">*</span>
                            </label>
                            <div class="stepper">
                                <button type="button" class="stepper-btn" onclick="changeGuest(-1)">−</button>
                                <input asp-for="GuestCount" type="number" class="stepper-input"
                                       id="inpGuest" min="1" max="50"
                                       oninput="updateSummary()" readonly />
                                <span class="stepper-label" id="guestLabel">kişi</span>
                                <button type="button" class="stepper-btn" onclick="changeGuest(1)">+</button>
                            </div>
                            <span asp-validation-for="GuestCount" class="field-error"></span>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ÖZEL NOT -->
            <div class="form-card">
                <div class="card-header">
                    <div class="card-header-icon" style="background:#f5f2ee;">
                        <i class="bi bi-chat-square-text" style="color:#aaa;"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Özel İstek / Not</p>
                        <p class="card-header-sub">Müşterinin isteği veya özel notlar.</p>
                    </div>
                </div>
                <div class="card-body">
                    <div class="form-group">
                        <div class="input-wrap textarea-wrap">
                            <i class="bi bi-chat-square-dots i-icon"></i>
                            <textarea asp-for="Description" class="form-control"
                                      placeholder="Doğum günü kutlaması, vejetaryen menü, yüksek sandalye gibi özel istekler..."
                                      rows="4"></textarea>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ═══════════════════ SAĞ KOLON ═══════════════════ -->
        <div class="sidebar-col">

            <!-- DURUM SEÇİCİ -->
            <div class="form-card" style="margin-bottom:16px;">
                <div class="card-header">
                    <div class="card-header-icon" style="background:#f5f2ee;">
                        <i class="bi bi-toggle-on" style="color:#aaa;"></i>
                    </div>
                    <div>
                        <p class="card-header-title">Rezervasyon Durumu</p>
                        <p class="card-header-sub">Başlangıç durumunu seçin.</p>
                    </div>
                </div>
                <div class="card-body">
                    <input asp-for="Status" type="hidden" id="hiddenStatus" />
                    <div class="status-picker">
                        <label class="status-option selected-beklemede" id="opt-beklemede" onclick="selectStatus('Beklemede')">
                            <span class="so-dot" style="background:#f59e0b;"></span>
                            <span class="so-label">Beklemede</span>
                            <i class="bi bi-check-circle-fill so-check" style="color:#f59e0b;"></i>
                        </label>
                        <label class="status-option" id="opt-onaylandi" onclick="selectStatus('Onaylandı')">
                            <span class="so-dot" style="background:var(--green);"></span>
                            <span class="so-label">Onaylandı</span>
                            <i class="bi bi-check-circle-fill so-check" style="color:var(--green);"></i>
                        </label>
                        <label class="status-option" id="opt-iptal" onclick="selectStatus('İptal Edildi')">
                            <span class="so-dot" style="background:var(--red);"></span>
                            <span class="so-label">İptal Edildi</span>
                            <i class="bi bi-check-circle-fill so-check" style="color:var(--red);"></i>
                        </label>
                    </div>
                </div>
            </div>

            <!-- ÖZET KARTI -->
            <div class="summary-card">
                <div class="summary-title">
                    <i class="bi bi-receipt"></i>
                    Rezervasyon Özeti
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-person-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Misafir</div>
                        <div class="sr-val" id="sumName">—</div>
                    </div>
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-telephone-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Telefon</div>
                        <div class="sr-val" id="sumPhone">—</div>
                    </div>
                </div>

                <hr class="summary-divider" />

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <div class="sr-lbl">Tarih</div>
                        <div class="sr-val" id="sumDate">—</div>
                    </div>
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Saat</div>
                        <div class="sr-val" id="sumTime">—</div>
                    </div>
                </div>

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Kişi Sayısı</div>
                        <div class="sr-val" id="sumGuest">2 kişi</div>
                    </div>
                </div>

                <hr class="summary-divider" />

                <div class="summary-row">
                    <div class="sr-icon"><i class="bi bi-circle-fill"></i></div>
                    <div>
                        <div class="sr-lbl">Durum</div>
                        <div class="sr-val" id="sumStatus">Beklemede</div>
                    </div>
                </div>

                <button type="submit" class="btn-submit">
                    <i class="bi bi-pencil-fill"></i>
                    Rezervasyonu Güncelle
                </button>

                <a href="/Reservation/ReservationList/" class="btn-cancel-form">
                    <i class="bi bi-x-lg"></i>
                    Vazgeç
                </a>
            </div>

            <!-- İPUÇLARI -->
            <div class="tips-card">
                <div class="tips-title">
                    <i class="bi bi-lightbulb-fill" style="color:var(--accent);"></i>
                    İpuçları
                </div>
                <div class="tip-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Telefon numarasını uluslararası formatta (+90) girebilirsiniz.</span>
                </div>
                <div class="tip-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Durum değişiklikleri kayıt üzerinde saklanır.</span>
                </div>
                <div class="tip-item">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Özel not alanı müşteriye görünmez, sadece personel içindir.</span>
                </div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <script>
        /* ── GUEST STEPPER ── */
        function changeGuest(delta) {
            var inp = document.getElementById('inpGuest');
            var val = parseInt(inp.value) || 2;
            val = Math.min(50, Math.max(1, val + delta));
            inp.value = val;
            updateSummary();
        }

        /* ── STATUS SELECTOR ── */
        var statusMap = {
            'Beklemede':    'opt-beklemede',
            'Onaylandı':    'opt-onaylandi',
            'İptal Edildi': 'opt-iptal'
        };
        var statusClassMap = {
            'Beklemede':    'selected-beklemede',
            'Onaylandı':    'selected-onaylandi',
            'İptal Edildi': 'selected-iptal'
        };

        function normalizeStatusDisplay(val) {
            var map = {
                'Pending': 'Beklemede',
                'Confirmed': 'Onaylandı',
                'Cancelled': 'İptal Edildi'
            };
            return map[val] || val;
        }

        function initStatusPicker() {
            var raw = document.getElementById('hiddenStatus').value;
            var display = normalizeStatusDisplay(raw);

            Object.keys(statusMap).forEach(function (k) {
                var el = document.getElementById(statusMap[k]);
                if (el) el.className = 'status-option';
            });

            var target = document.getElementById(statusMap[display]);
            if (target && statusClassMap[display]) {
                target.classList.add(statusClassMap[display]);
            }
        }

        function selectStatus(val) {
            document.getElementById('hiddenStatus').value = val;

            // Reset all
            Object.keys(statusMap).forEach(function(k) {
                var el = document.getElementById(statusMap[k]);
                el.className = 'status-option';
            });

            // Activate selected
            var target = document.getElementById(statusMap[val]);
            if (target) target.classList.add(statusClassMap[val]);

            updateSummary();
        }

        /* ── LIVE SUMMARY ── */
        var TR_DAYS   = ['Pazar','Pazartesi','Salı','Çarşamba','Perşembe','Cuma','Cumartesi'];
        var TR_MONTHS = ['Ocak','Şubat','Mart','Nisan','Mayıs','Haziran','Temmuz','Ağustos','Eylül','Ekim','Kasım','Aralık'];

        function updateSummary() {
            /* Name */
            var name = (document.getElementById('inpName').value || '').trim();
            document.getElementById('sumName').textContent = name || '—';

            /* Phone */
            var phone = (document.getElementById('inpPhone').value || '').trim();
            document.getElementById('sumPhone').textContent = phone || '—';

            /* Date */
            var dateVal = document.getElementById('inpDate').value;
            if (dateVal) {
                var d = new Date(dateVal + 'T00:00:00');
                var formatted = TR_DAYS[d.getDay()] + ', ' + d.getDate() + ' ' + TR_MONTHS[d.getMonth()] + ' ' + d.getFullYear();
                document.getElementById('sumDate').textContent = formatted;
            } else {
                document.getElementById('sumDate').textContent = '—';
            }

            /* Time */
            var timeVal = document.getElementById('inpTime').value;
            document.getElementById('sumTime').textContent = timeVal || '—';

            /* Guest */
            var guest = parseInt(document.getElementById('inpGuest').value) || 2;
            document.getElementById('sumGuest').textContent = guest + ' kişi';

            /* Status */
            document.getElementById('sumStatus').textContent =
                normalizeStatusDisplay(document.getElementById('hiddenStatus').value);
        }

        document.addEventListener('DOMContentLoaded', function () {
            initStatusPicker();
            updateSummary();
        });
    </script>
}


