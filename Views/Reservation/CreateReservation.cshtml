@model CreateReservationDto
@using System.Globalization
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Rezervasyon";
    ViewData["MetaDescription"] = "HotCoffee için masa rezervasyon talebi oluşturun.";
    var tr = CultureInfo.GetCultureInfo("tr-TR");
}

<div class="hc-page hc-page-form">
<div class="hc-form-shell">
    <h1>Rezervasyon talebi</h1>
    <p class="hc-form-lead">
        Formu doldurarak rezervasyon talebinizi iletebilirsiniz.
        Talebiniz alındıktan sonra restoran ekibimiz uygunluğu değerlendirir; onay ayrı bir adımdır.
    </p>

    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

    <form asp-controller="Reservation" asp-action="CreateReservation" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div class="hc-form-grid">
            <div class="hc-field">
                <label asp-for="Name">Ad Soyad</label>
                <input asp-for="Name" autocomplete="name" />
                <span asp-validation-for="Name" class="hc-field-error"></span>
            </div>
            <div class="hc-field">
                <label asp-for="Phone">Telefon</label>
                <input asp-for="Phone" autocomplete="tel" inputmode="tel" />
                <span asp-validation-for="Phone" class="hc-field-error"></span>
            </div>
            <div class="hc-field">
                <label asp-for="Email">E-posta</label>
                <input asp-for="Email" autocomplete="email" inputmode="email" />
                <span asp-validation-for="Email" class="hc-field-error"></span>
            </div>
            <div class="hc-field">
                <label asp-for="GuestCount">Misafir sayısı</label>
                <input asp-for="GuestCount" type="number" min="1" max="50" />
                <span asp-validation-for="GuestCount" class="hc-field-error"></span>
            </div>
            <div class="hc-field">
                <label asp-for="ReservationDate">Tarih</label>
                <input asp-for="ReservationDate" type="date" />
                <span asp-validation-for="ReservationDate" class="hc-field-error"></span>
            </div>
            <div class="hc-field">
                <label asp-for="ReservationTime">Saat</label>
                <input asp-for="ReservationTime" type="time" />
                <span asp-validation-for="ReservationTime" class="hc-field-error"></span>
            </div>
        </div>

        <div class="hc-field">
            <label asp-for="Description">Not (isteğe bağlı)</label>
            <textarea asp-for="Description" rows="4"></textarea>
            <span asp-validation-for="Description" class="hc-field-error"></span>
        </div>

        <div class="hc-form-actions">
            <button type="submit" class="hc-btn hc-btn-primary">Talebi Gönder</button>
            <a class="hc-btn hc-btn-secondary" asp-controller="Menu" asp-action="Index">Menüye Dön</a>
        </div>
    </form>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
