@model List<ResultReservationDto>
@using DatabaseMastery.HotCoffeePostgreSQL.Domain
@using DatabaseMastery.HotCoffeePostgreSQL.Services.Time
@inject IBusinessClock BusinessClock

@{
    ViewData["Title"] = "ReservationList";
    Layout = "~/Views/AdminLayout/Index.cshtml";

    var businessToday = BusinessClock.Today;
    var total = Model?.Count ?? 0;
    var pending = Model?.Count(r => r.Status == ReservationStatus.Pending) ?? 0;
    var approved = Model?.Count(r => r.Status == ReservationStatus.Confirmed) ?? 0;
    var cancelled = Model?.Count(r => r.Status == ReservationStatus.Cancelled) ?? 0;
    var today = Model?.Count(r => r.ReservationDate == businessToday) ?? 0;
}
<!-- ── PAGE HEADER ── -->
<div class="pg-header">
    <div>
        <h1 class="pg-title">
            <i class="bi bi-calendar2-check-fill me-2" style="color:var(--accent);font-size:20px;vertical-align:middle;"></i>
            Rezervasyon Yönetimi
        </h1>
        <p class="pg-desc">Tüm rezervasyonları görüntüleyin ve yönetin.</p>
    </div>
    <a href="/Reservation/CreateReservation/" class="btn-add">
        <i class="bi bi-plus-lg"></i>
        Yeni Rezervasyon
    </a>
</div>

<!-- ── STAT CARDS ── -->
<div class="stat-grid">
    <div class="stat-card stat-card-clickable" role="button" tabindex="0"
         onclick="applyStatusFilter('all')" onkeydown="statCardKey(event, function(){ applyStatusFilter('all'); })">
        <div class="stat-icon" style="background:#f5f2ee;">
            <i class="bi bi-calendar2-week-fill" style="color:#aaa;"></i>
        </div>
        <div>
            <div class="stat-num">@total</div>
            <div class="stat-lbl">Toplam</div>
        </div>
    </div>
    <div class="stat-card stat-card-clickable" role="button" tabindex="0"
         onclick="applyStatusFilter('beklemede')" onkeydown="statCardKey(event, function(){ applyStatusFilter('beklemede'); })">
        <div class="stat-icon" style="background:var(--yellow-soft);">
            <i class="bi bi-hourglass-split" style="color:var(--yellow);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#b45309;">@pending</div>
            <div class="stat-lbl">Beklemede</div>
        </div>
    </div>
    <div class="stat-card stat-card-clickable" role="button" tabindex="0"
         onclick="applyStatusFilter('onaylandi')" onkeydown="statCardKey(event, function(){ applyStatusFilter('onaylandi'); })">
        <div class="stat-icon" style="background:var(--green-soft);">
            <i class="bi bi-check-circle-fill" style="color:var(--green);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#16a34a;">@approved</div>
            <div class="stat-lbl">Onaylandı</div>
        </div>
    </div>
    <div class="stat-card stat-card-clickable" role="button" tabindex="0"
         onclick="applyStatusFilter('iptal')" onkeydown="statCardKey(event, function(){ applyStatusFilter('iptal'); })">
        <div class="stat-icon" style="background:var(--red-soft);">
            <i class="bi bi-x-circle-fill" style="color:var(--red);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:#dc2626;">@cancelled</div>
            <div class="stat-lbl">İptal Edildi</div>
        </div>
    </div>
    <div class="stat-card stat-card-clickable" role="button" tabindex="0"
         onclick="applyTodayFilter()" onkeydown="statCardKey(event, applyTodayFilter)">
        <div class="stat-icon" style="background:var(--accent-soft);">
            <i class="bi bi-calendar-day-fill" style="color:var(--accent-dark);"></i>
        </div>
        <div>
            <div class="stat-num" style="color:var(--accent-dark);">@today</div>
            <div class="stat-lbl">Bugünkü</div>
        </div>
    </div>
</div>

<!-- ── TOOLBAR ── -->
<div class="toolbar">
    <div class="search-wrap">
        <i class="bi bi-search si"></i>
        <input type="text" class="search-input" id="searchInput"
               placeholder="Ad, telefon veya e-posta ara..."
               oninput="filterTable()" />
    </div>

    <select class="f-select" id="statusFilter" onchange="filterTable()">
        <option value="all">Tüm Durumlar</option>
        <option value="beklemede">Beklemede</option>
        <option value="onaylandi">Onaylandı</option>
        <option value="iptal">İptal Edildi</option>
    </select>

    <select class="f-select" id="dateFilter" onchange="filterTable()">
        <option value="all">Tüm Tarihler</option>
        <option value="today">Bugün</option>
        <option value="upcoming">Yaklaşan</option>
        <option value="past">Geçmiş</option>
    </select>

    <select class="f-select" id="sortSelect" onchange="sortTable()">
        <option value="default">Sıralama</option>
        <option value="date-asc">Tarih ↑</option>
        <option value="date-desc">Tarih ↓</option>
        <option value="name-asc">Ad A→Z</option>
        <option value="name-desc">Ad Z→A</option>
        <option value="guest-asc">Kişi Sayısı ↑</option>
        <option value="guest-desc">Kişi Sayısı ↓</option>
    </select>

    <div class="toolbar-right">
        <span class="result-count" id="resultCount">@total rezervasyon</span>
    </div>
</div>

<!-- ── TABLE CARD ── -->
<div class="tbl-card">
    <div style="overflow-x:auto;">
        <table class="res-table" id="resTable">
            <thead>
                <tr>
                    <th class="col-num no-sort">#</th>
                    <th class="col-name" onclick="sortBy('name')">Ad Soyad <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="col-phone no-sort">Telefon</th>
                    <th class="col-date" onclick="sortBy('date')">Tarih <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="col-time no-sort">Saat</th>
                    <th class="col-guest" onclick="sortBy('guest')">Kişi <i class="bi bi-chevron-expand sort-icon"></i></th>
                    <th class="col-stat no-sort">Durum</th>
                    <th class="col-note no-sort">Not</th>
                    <th class="col-act no-sort">İşlem</th>
                </tr>
            </thead>
            <tbody id="resBody">

                @if (Model == null || !Model.Any())
                {
                    <tr class="empty-row">
                        <td colspan="9">
                            <div class="empty-inner">
                                <div class="empty-ico"><i class="bi bi-calendar2-x"></i></div>
                                <div class="empty-title">Henüz rezervasyon yok</div>
                                <p class="empty-sub">İlk rezervasyonu ekleyin.</p>
                                <a href="/Reservation/CreateReservation/" class="btn-add" style="display:inline-flex;">
                                    <i class="bi bi-plus-lg"></i> Yeni Rezervasyon
                                </a>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        var r = Model[i];

                        var displayStatus = ReservationStatusPresentation.GetDisplayName(r.Status);
                        var statusClass = r.Status switch
                        {
                            ReservationStatus.Pending => "beklemede",
                            ReservationStatus.Confirmed => "onaylandi",
                            ReservationStatus.Cancelled => "iptal",
                            _ => "other"
                        };

                        // Tarih bilgisi
                        var dateStr = TurkishDatePresentation.FormatDate(r.ReservationDate);
                        var dayName = TurkishDatePresentation.FormatDayName(r.ReservationDate);
                        var timeStr = r.ReservationTime.ToString("HH:mm");
                        var isToday = r.ReservationDate == businessToday;
                        var isPast = r.ReservationDate < businessToday;
                        var dateGroup = isToday ? "today" : isPast ? "past" : "upcoming";

                        <tr data-name="@r.Name.ToLower()"
                            data-phone="@r.Phone"
                            data-email="@(r.Email?.ToLower() ?? "")"
                            data-status="@statusClass"
                            data-date="@r.ReservationDate.ToString("yyyy-MM-dd")"
                            data-dategroup="@dateGroup"
                            data-guest="@r.GuestCount">
                            <td class="col-num">
                                <span class="row-num">@(i + 1)</span>
                            </td>
                            <td class="col-name">
                                <div class="contact-name">@r.Name</div>
                                @if (!string.IsNullOrWhiteSpace(r.Email))
                                {
                                    <div class="contact-email">@r.Email</div>
                                }
                            </td>
                            <td class="col-phone">
                                <a href="tel:@r.Phone" class="phone-link">
                                    <i class="bi bi-telephone-fill" style="font-size:11px;color:var(--accent);"></i>
                                    @r.Phone
                                </a>
                            </td>
                            <td class="col-date">
                                <div class="date-cell">
                                    @if (isToday)
                                    {
                                        <span style="color:var(--accent-dark);">Bugün</span>
                                    }
                                    else
                                    {
                                        @dateStr
                                    }
                                </div>
                                <div class="date-sub">@dayName</div>
                            </td>
                            <td class="col-time">
                                <span class="time-cell">
                                    <i class="bi bi-clock" style="font-size:11px;color:var(--accent);"></i>
                                    @timeStr
                                </span>
                            </td>
                            <td class="col-guest">
                                <span class="guest-badge">
                                    <i class="bi bi-people-fill" style="font-size:10px;"></i>
                                    @r.GuestCount
                                </span>
                            </td>
                            <td class="col-stat">
                                <span class="s-badge @statusClass">
                                    <span class="s-dot"></span>
                                    @displayStatus
                                </span>
                            </td>
                            <td class="col-note">
                                @if (!string.IsNullOrWhiteSpace(r.Description))
                                {
                                    <span class="note-text" title="@r.Description">@r.Description</span>
                                }
                                else
                                {
                                    <span class="note-empty">—</span>
                                }
                            </td>
                            <td class="col-act">
                                <div class="act-group">
                                    <a href="/Reservation/UpdateReservation/@r.ReservationId"
                                       class="btn-act edit" data-tip="Düzenle">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <form asp-controller="Reservation" asp-action="ApproveReservation" asp-route-id="@r.ReservationId" method="post" class="d-inline">
                                        <button type="submit" class="btn-act approve" data-tip="Onayla">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>

                                    <form asp-controller="Reservation" asp-action="PendingReservation" asp-route-id="@r.ReservationId" method="post" class="d-inline">
                                        <button type="submit" class="btn-act pending" data-tip="Beklet">
                                            <i class="bi bi-hourglass-split"></i>
                                        </button>
                                    </form>

                                    <form asp-controller="Reservation" asp-action="CancelReservation" asp-route-id="@r.ReservationId" method="post" class="d-inline">
                                        <button type="submit" class="btn-act cancel" data-tip="İptal Et">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </form>

                                    <button class="btn-act del" data-tip="Sil"
                                            onclick="confirmDelete(@r.ReservationId, '@r.Name')">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <!-- TABLE FOOTER -->
    <div class="tbl-footer">
        <div class="tf-info">
            Toplam <strong id="visibleCount">@total</strong> rezervasyon gösteriliyor
        </div>
        <div class="tf-per">
            <span>Sayfa başına:</span>
            <select class="per-select" id="perPage" onchange="renderPagination()">
                <option value="25">25</option>
                <option value="50" selected>50</option>
                <option value="100">100</option>
                <option value="9999">Tümü</option>
            </select>
        </div>
        <div class="pag" id="pagination"></div>
    </div>
</div>

<!-- ── DELETE MODAL ── -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:400px;">
        <div class="modal-content del-mc">
            <div class="del-mb">
                <div style="width:62px;height:62px;background:#fff5f5;border-radius:50%;
                            display:flex;align-items:center;justify-content:center;
                            margin:0 auto 16px;font-size:24px;color:#ef4444;border:1.5px solid #fecaca;">
                    <i class="bi bi-trash3-fill"></i>
                </div>
                <div class="del-mt">Rezervasyon Silinsin mi?</div>
                <p style="font-size:13.5px;color:#888;margin-bottom:4px;">
                    <strong id="delResName" style="color:#333;"></strong> adına kayıtlı rezervasyon kalıcı olarak silinecek.
                </p>
                <p style="font-size:12px;color:#ccc;margin-bottom:0;">Bu işlem geri alınamaz.</p>
            </div>
            <div class="del-mf">
                <button class="btn-cancel-m" type="button" data-bs-dismiss="modal">Vazgeç</button>
                <form asp-controller="Reservation" asp-action="DeleteReservation" method="post" class="m-0 flex-fill">
                    <input type="hidden" name="id" id="delReservationId" value="0" />
                    <button type="submit" class="btn-del-ok w-100">
                        <i class="bi bi-trash3-fill"></i> Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        /* ─── STATE ─────────────────────────────────────── */
        var allRows  = [];
        var filtered = [];
        var curPage  = 1;
        var sortField = null;
        var sortDir   = 'asc';

        /* ─── INIT ──────────────────────────────────────── */
        document.addEventListener('DOMContentLoaded', function () {
            allRows  = Array.from(document.querySelectorAll('#resBody tr[data-name]'));
            filtered = allRows.slice();
            renderPagination();
            showPage(1);
        });

        /* ─── FILTER ────────────────────────────────────── */
        function applyStatusFilter(status) {
            var select = document.getElementById('statusFilter');
            if (!select) return;

            select.value = status;
            filterTable();
        }

        function applyTodayFilter() {
            var statusSelect = document.getElementById('statusFilter');
            var dateSelect = document.getElementById('dateFilter');
            if (!dateSelect) return;

            if (statusSelect) statusSelect.value = 'all';
            dateSelect.value = 'today';
            filterTable();
        }

        function statCardKey(event, action) {
            if (event.key === 'Enter' || event.key === ' ') {
                event.preventDefault();
                action();
            }
        }

        function filterTable() {
            var q      = document.getElementById('searchInput').value.toLowerCase().trim();
            var status = document.getElementById('statusFilter').value;
            var date   = document.getElementById('dateFilter').value;

            filtered = allRows.filter(function (row) {
                var nm = (row.dataset.name  || '').includes(q) ||
                         (row.dataset.phone || '').includes(q) ||
                         (row.dataset.email || '').includes(q);
                var sm = status === 'all' || row.dataset.status    === status;
                var dm = date   === 'all' || row.dataset.dategroup === date;
                return nm && sm && dm;
            });

            if (sortField) applySortToFiltered();
            curPage = 1;
            renderPagination();
            showPage(1);
            updateCounts();
        }

        /* ─── SORT ──────────────────────────────────────── */
        function sortBy(field) {
            if (sortField === field) { sortDir = sortDir === 'asc' ? 'desc' : 'asc'; }
            else { sortField = field; sortDir = 'asc'; }

            document.querySelectorAll('.res-table thead th').forEach(function (th) {
                th.classList.remove('sorted');
                var ico = th.querySelector('.sort-icon');
                if (ico) ico.className = 'bi bi-chevron-expand sort-icon';
            });

            var colMap = { name: 1, date: 3, guest: 5 };
            var idx = colMap[field];
            var th  = document.querySelectorAll('.res-table thead th')[idx];
            if (th) {
                th.classList.add('sorted');
                var ico = th.querySelector('.sort-icon');
                if (ico) ico.className = 'bi bi-chevron-' + (sortDir === 'asc' ? 'up' : 'down') + ' sort-icon';
            }

            applySortToFiltered();
            curPage = 1; renderPagination(); showPage(1);
        }

        function sortTable() {
            var val = document.getElementById('sortSelect').value;
            if (val === 'default') { sortField = null; filterTable(); return; }
            var parts = val.split('-');
            sortField = parts[0]; sortDir = parts[1];
            applySortToFiltered();
            curPage = 1; renderPagination(); showPage(1);
        }

        function applySortToFiltered() {
            filtered.sort(function (a, b) {
                if (sortField === 'name') {
                    var av = a.dataset.name, bv = b.dataset.name;
                    return sortDir === 'asc' ? av.localeCompare(bv, 'tr') : bv.localeCompare(av, 'tr');
                }
                if (sortField === 'date') {
                    var av = new Date(a.dataset.date), bv = new Date(b.dataset.date);
                    return sortDir === 'asc' ? av - bv : bv - av;
                }
                if (sortField === 'guest') {
                    var av = parseInt(a.dataset.guest), bv = parseInt(b.dataset.guest);
                    return sortDir === 'asc' ? av - bv : bv - av;
                }
                return 0;
            });
        }

        /* ─── PAGINATION ────────────────────────────────── */
        function renderPagination() {
            var per   = parseInt(document.getElementById('perPage').value);
            var pages = per >= 9999 ? 1 : Math.ceil(filtered.length / per);
            var pag   = document.getElementById('pagination');
            if (!pag) return;
            if (pages <= 1) { pag.innerHTML = ''; return; }

            var html = '';
            html += '<button class="pag-btn" ' + (curPage <= 1 ? 'disabled' : '') + ' onclick="goPage(' + (curPage - 1) + ')"><i class="bi bi-chevron-left"></i></button>';
            for (var i = 1; i <= pages; i++) {
                if (pages > 7 && i > 2 && i < pages - 1 && Math.abs(i - curPage) > 1) {
                    if (i === 3 || i === pages - 2) html += '<span class="pag-ellipsis">…</span>';
                    continue;
                }
                html += '<button class="pag-btn ' + (i === curPage ? 'active' : '') + '" onclick="goPage(' + i + ')">' + i + '</button>';
            }
            html += '<button class="pag-btn" ' + (curPage >= pages ? 'disabled' : '') + ' onclick="goPage(' + (curPage + 1) + ')"><i class="bi bi-chevron-right"></i></button>';
            pag.innerHTML = html;
        }

        function goPage(n) {
            curPage = n; showPage(n); renderPagination();
            document.querySelector('.tbl-card').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function showPage(n) {
            var per   = parseInt(document.getElementById('perPage').value);
            var start = per >= 9999 ? 0 : (n - 1) * per;
            var end   = per >= 9999 ? filtered.length : start + per;

            allRows.forEach(function (r) { r.style.display = 'none'; });
            filtered.forEach(function (r, i) {
                r.style.display = (i >= start && i < end) ? '' : 'none';
                var chip = r.querySelector('.row-num');
                if (chip) chip.textContent = i + 1;
            });

            var emptyRow = document.querySelector('.empty-row');
            if (emptyRow) emptyRow.style.display = filtered.length === 0 ? '' : 'none';
            if (filtered.length === 0 && !emptyRow) {
                var body = document.getElementById('resBody');
                var tr   = document.createElement('tr');
                tr.className = 'empty-row temp-empty';
                tr.innerHTML = '<td colspan="9"><div class="empty-inner"><div class="empty-ico"><i class="bi bi-search"></i></div><div class="empty-title">Sonuç bulunamadı</div><p class="empty-sub">Filtre veya arama kriterlerinizi değiştirin.</p></div></td>';
                var existing = body.querySelector('.temp-empty');
                if (existing) existing.remove();
                body.appendChild(tr);
            } else {
                var te = document.querySelector('.temp-empty');
                if (te) te.remove();
            }
        }

        function updateCounts() {
            var vc = document.getElementById('visibleCount');
            if (vc) vc.textContent = filtered.length;
            var rc = document.getElementById('resultCount');
            if (rc) rc.textContent = filtered.length + ' rezervasyon';
        }

        /* ─── DELETE ─────────────────────────────────────── */
        function confirmDelete(id, name) {
            document.getElementById('delResName').textContent = name;
            document.getElementById('delReservationId').value = id;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }
    </script>
}

