@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}

@section AdminStyles {
    <link rel="stylesheet" href="~/css/hotcoffee-admin-dashboard.css" asp-append-version="true" />
}

<div class="dashboard-wrap">
    @await Component.InvokeAsync("_DashboardHeaderComponentPartial")
    @await Component.InvokeAsync("_DashboardStatisticsCardsComponentPartial")
    @await Component.InvokeAsync("_DashboardLastReservationsComponentPartial")
    @await Component.InvokeAsync("_ChartComponentPartial")

    <div class="row g-3">
        @await Component.InvokeAsync("_DashboardQuickActionsComponentPartial")
        @await Component.InvokeAsync("_DashboardRecentReviewsComponentPartial")
        @await Component.InvokeAsync("_DashboardWeeklySummaryComponentPartial")
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/hotcoffee-admin-charts.js" asp-append-version="true"></script>
}
