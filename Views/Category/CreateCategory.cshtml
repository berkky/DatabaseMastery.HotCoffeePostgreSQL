@model CreateCategoryDto

@{
    ViewData["Title"] = "CreateCategory";
    Layout = "~/Views/AdminLayout/Index.cshtml";
}
<!-- BREADCRUMB -->
<div class="bc-bar">
    <a href="/Admin/Dashboard"><i class="bi bi-house-fill" style="font-size:11px;"></i></a>
    <span style="opacity:.4;"><i class="bi bi-chevron-right" style="font-size:10px;"></i></span>
    <a href="/Admin/Category">Kategori Yönetimi</a>
    <span style="opacity:.4;"><i class="bi bi-chevron-right" style="font-size:10px;"></i></span>
    <span class="bc-cur">Yeni Kategori</span>
</div>

<!-- PAGE HEADER -->
<div class="add-header">
    <a href="/Admin/Category" class="back-btn" title="Geri">
        <i class="bi bi-arrow-left"></i>
    </a>
    <div>
        <h1 class="add-title">
            <i class="bi bi-plus-circle-fill me-2" style="color:var(--accent);font-size:19px;vertical-align:middle;"></i>
            Yeni Kategori Ekle
        </h1>
        <p class="add-desc">Menünüze yeni bir kategori oluşturun ve yayına alın.</p>
    </div>
</div>

<!-- FORM -->
<form id="addForm" asp-action="CreateCategory" asp-controller="Category" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="add-layout">

        <!-- LEFT COLUMN -->
        <div>

            <!-- General Info -->
            <div class="f-card">
                <div class="f-card-head">
                    <div class="head-icon"><i class="bi bi-info-circle-fill"></i></div>
                    <div>
                        <div class="head-title">Genel Bilgiler</div>
                        <div class="head-sub">Kategori adı ve yayın durumu</div>
                    </div>
                </div>
                <div class="f-card-body">

                    <!-- Name -->
                    <div class="fg" id="fg-name">
                        <div class="fl">
                            <label for="CategoryName">Kategori Adı</label>
                            <span class="lbl-req">* Zorunlu</span>
                        </div>
                        <div class="fi-wrap">
                            <i class="bi bi-tag-fill fi-ico"></i>
                            <input type="text"
                                   id="CategoryName"
                                   name="CategoryName"
                                   asp-for="CategoryName"
                                   class="f-input f-input-pl f-input-pr"
                                   placeholder="Örn: Ana Yemekler, Başlangıçlar..."
                                   maxlength="50"
                                   autocomplete="off"
                                   oninput="onName(this)" />
                            <span class="char-count" id="nameCount">0/50</span>
                        </div>
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                        <div class="f-err" id="nameErr">
                            <i class="bi bi-exclamation-circle-fill"></i> Kategori adı boş bırakılamaz.
                        </div>
                        <div class="f-hint">
                            <i class="bi bi-lightbulb" style="color:var(--accent);"></i>
                            Kısa ve açıklayıcı bir isim seçin.
                        </div>
                    </div>

                    <!-- Status -->
                    <div class="fg">
                        <div class="fl"><label>Yayın Durumu</label></div>
                        <div class="st-wrap">
                            <div class="st-opt opt-a">
                                <input type="radio" name="CategoryStatus" id="stA" value="true" checked onchange="updateStatus(true)" />
                                <label for="stA">
                                    <div class="so-ico"><i class="bi bi-check-circle-fill"></i></div>
                                    <div>
                                        <span class="so-lbl">Aktif</span>
                                        <span class="so-sub">Menüde görünür</span>
                                    </div>
                                    <div class="so-chk"><i class="bi bi-check"></i></div>
                                </label>
                            </div>
                            <div class="st-opt opt-p">
                                <input type="radio" name="CategoryStatus" id="stP" value="false" onchange="updateStatus(false)" />
                                <label for="stP">
                                    <div class="so-ico"><i class="bi bi-pause-circle-fill"></i></div>
                                    <div>
                                        <span class="so-lbl">Pasif</span>
                                        <span class="so-sub">Menüde gizli</span>
                                    </div>
                                    <div class="so-chk"><i class="bi bi-check"></i></div>
                                </label>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Image -->
            <div class="f-card">
                <div class="f-card-head">
                    <div class="head-icon"><i class="bi bi-image-fill"></i></div>
                    <div>
                        <div class="head-title">Kategori Görseli</div>
                        <div class="head-sub">Dosya yükle veya URL gir</div>
                    </div>
                </div>

                <div class="up-tabs">
                    <div class="utab active" id="tab-btn-upload" onclick="switchTab('upload')">
                        <i class="bi bi-upload me-1"></i> Dosya Yükle
                    </div>
                    <div class="utab" id="tab-btn-url" onclick="switchTab('url')">
                        <i class="bi bi-link-45deg me-1"></i> URL ile Ekle
                    </div>
                </div>

                <!-- Upload Panel -->
                <div class="utab-p active" id="tab-upload">
                    <div class="drop-zone" id="dropZone">
                        <input type="file" id="imgFile" name="CategoryImage" accept="image/*" onchange="onFileChange(event)" />
                        <div id="dzDefault">
                            <div class="dz-ico"><i class="bi bi-cloud-arrow-up-fill"></i></div>
                            <div class="dz-title">Görseli buraya sürükleyin</div>
                            <p class="dz-sub">veya <span onclick="document.getElementById('imgFile').click()">tıklayın</span><br>PNG, JPG, WEBP — maks. 5MB</p>
                        </div>
                        <div class="dz-prev" id="dzPrev">
                            <img id="dzImg" src="" alt="" />
                            <button type="button" class="dz-rm" onclick="removeImg(event)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                    </div>
                    <div class="up-note">
                        <i class="bi bi-shield-check" style="color:var(--green);"></i>
                        Güvenli yükleme &middot; JPG, PNG, WEBP, GIF desteklenir
                    </div>
                </div>

                <!-- URL Panel -->
                <div class="utab-p" id="tab-url">
                    <div class="fg" style="margin-bottom:0;">
                        <div class="fl">
                            <label for="CategoryImageUrl">Görsel URL</label>
                            <span class="lbl-opt">Opsiyonel</span>
                        </div>
                        <div class="fi-wrap">
                            <i class="bi bi-link-45deg fi-ico"></i>
                            <input type="url"
                                   id="CategoryImageUrl"
                                   name="CategoryImageUrl"
                                   asp-for="CategoryImageUrl"
                                   class="f-input f-input-pl"
                                   placeholder="https://ornek.com/gorsel.jpg"
                                   oninput="onUrl(this)" />
                        </div>
                        <span asp-validation-for="CategoryImageUrl" class="text-danger"></span>
                        <div class="f-hint">
                            <i class="bi bi-info-circle"></i>
                            Harici bir görsel bağlantısı girebilirsiniz.
                        </div>
                    </div>
                </div>

            </div>

        </div>

        <!-- RIGHT COLUMN -->
        <div class="right-col" style="display:flex;flex-direction:column;gap:16px;">

            <!-- Live Preview -->
            <div class="prev-card">
                <div class="prev-head">
                    <div class="head-icon" style="width:28px;height:28px;font-size:13px;">
                        <i class="bi bi-eye-fill"></i>
                    </div>
                    <span class="prev-head-title">Canlı Önizleme</span>
                    <div class="live-dot"></div>
                </div>
                <div class="pci">
                    <div class="pci-img" id="pciImg">
                        <i class="bi bi-image" id="pciPh"></i>
                        <img id="pciPreview" src="" alt="" />
                        <span class="pci-badge active" id="pciBadge">
                            <span class="pci-bdot"></span>
                            <span id="pciSText">Aktif</span>
                        </span>
                    </div>
                    <div class="pci-foot">
                        <span class="pci-name ph" id="pciName">Kategori adı...</span>
                        <div class="pci-acts">
                            <div class="pci-btn e"><i class="bi bi-pencil-fill"></i></div>
                            <div class="pci-btn d"><i class="bi bi-trash3-fill"></i></div>
                        </div>
                    </div>
                </div>
                <p class="prev-note">Kategori listesinde bu şekilde görünecek</p>
            </div>

            <!-- Submit -->
            <div class="sub-card">
                <button type="submit" class="btn-sub" id="submitBtn">
                    <i class="bi bi-plus-circle-fill"></i>
                    Kategori Oluştur
                </button>
                <a href="/Admin/Category" class="btn-back">
                    <i class="bi bi-x-lg"></i>
                    Vazgeç
                </a>
            </div>

            <!-- Tips -->
            <div class="tips-card">
                <div class="tips-title">
                    <i class="bi bi-lightbulb-fill"></i> İpuçları
                </div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Kısa ve akılda kalıcı isimler kullanın.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Görseller 4:3 veya 16:9 oranında en iyi görünür.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Hazır değilse Pasif olarak kaydedebilirsiniz.</div>
                <div class="tip"><i class="bi bi-check-circle-fill"></i>Görsel boyutunu 5MB altında tutun.</div>
            </div>

        </div>

    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
<script>
    /* Name input */
    function onName(el) {
        document.getElementById('nameCount').textContent = el.value.length + '/50';
        var nameEl = document.getElementById('pciName');
        if (el.value.trim()) {
            nameEl.textContent = el.value;
            nameEl.classList.remove('ph');
            document.getElementById('fg-name').classList.remove('is-invalid');
            document.getElementById('fg-name').classList.add('is-valid');
        } else {
            nameEl.textContent = 'Kategori adı...';
            nameEl.classList.add('ph');
            document.getElementById('fg-name').classList.remove('is-valid');
        }
    }

    /* Status */
    function updateStatus(active) {
        var b = document.getElementById('pciBadge');
        b.className = 'pci-badge ' + (active ? 'active' : 'passive');
        document.getElementById('pciSText').textContent = active ? 'Aktif' : 'Pasif';
    }

    /* Drop zone */
    var dz = document.getElementById('dropZone');
    dz.addEventListener('dragover', function(e) { e.preventDefault(); dz.classList.add('over'); });
    dz.addEventListener('dragleave', function() { dz.classList.remove('over'); });
    dz.addEventListener('drop', function(e) {
        e.preventDefault(); dz.classList.remove('over');
        var f = e.dataTransfer.files[0];
        if (f && f.type.startsWith('image/')) readFile(f);
    });

    function onFileChange(e) { if (e.target.files[0]) readFile(e.target.files[0]); }

    function readFile(file) {
        var r = new FileReader();
        r.onload = function(e) { setPreview(e.target.result); };
        r.readAsDataURL(file);
    }

    function setPreview(src) {
        document.getElementById('dzImg').src = src;
        document.getElementById('dzDefault').style.display = 'none';
        document.getElementById('dzPrev').style.display = 'block';
        var p = document.getElementById('pciPreview');
        p.src = src; p.style.display = 'block';
        document.getElementById('pciPh').style.display = 'none';
    }

    function removeImg(e) {
        e.stopPropagation();
        document.getElementById('dzImg').src = '';
        document.getElementById('dzDefault').style.display = '';
        document.getElementById('dzPrev').style.display = 'none';
        document.getElementById('imgFile').value = '';
        var p = document.getElementById('pciPreview');
        p.src = ''; p.style.display = 'none';
        document.getElementById('pciPh').style.display = '';
    }

    /* URL preview */
    var urlTimer;
    function onUrl(el) {
        clearTimeout(urlTimer);
        urlTimer = setTimeout(function() {
            var url = el.value.trim();
            if (url) {
                var img = new Image();
                img.onload = function() { setPreview(url); };
                img.src = url;
            }
        }, 600);
    }

    /* Tab switch */
    function switchTab(tab) {
        document.getElementById('tab-btn-upload').classList.toggle('active', tab === 'upload');
        document.getElementById('tab-btn-url').classList.toggle('active', tab === 'url');
        document.getElementById('tab-upload').classList.toggle('active', tab === 'upload');
        document.getElementById('tab-url').classList.toggle('active', tab === 'url');
    }

    /* Submit */
    document.getElementById('addForm').addEventListener('submit', function(e) {
        var name = document.getElementById('CategoryName').value.trim();
        if (!name) {
            e.preventDefault();
            document.getElementById('fg-name').classList.add('is-invalid');
            document.getElementById('CategoryName').focus();
            return;
        }
        var btn = document.getElementById('submitBtn');
        btn.classList.add('loading');
        btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Kaydediliyor...';
    });
</script>
}
