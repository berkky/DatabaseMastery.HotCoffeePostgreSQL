@model DatabaseMastery.HotCoffeePostgreSQL.Dtos.AdminAnalyticsDtos.DashboardOverviewDto

<div class="col-xl-4">
    <div class="dash-card h-100">
        <div class="dash-card-header">
            <div>
                <div class="section-title">Operasyon Özeti</div>
                <div class="section-sub">Rezervasyon ve değerlendirme oranları</div>
            </div>
        </div>
        <div class="dash-card-body">

            <div class="d-flex flex-column gap-3">

                <div>
                    <div class="d-flex justify-content-between mb-1" style="font-size:12.5px;">
                        <span style="font-weight:600;">Onay Oranı</span>
                        <span style="font-weight:700;color:#16a34a;">%@Model.ConfirmationRatePercent.ToString("0.#")</span>
                    </div>
                    <div style="background:#f0ede8;border-radius:6px;height:7px;overflow:hidden;">
                        <div style="width:@Model.ConfirmationRatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:linear-gradient(90deg,var(--green),#16a34a);border-radius:6px;"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between mb-1" style="font-size:12.5px;">
                        <span style="font-weight:600;">Yaklaşan Rezervasyon</span>
                        <span style="font-weight:700;color:var(--accent-dark);">@Model.UpcomingReservations</span>
                    </div>
                    <div style="font-size:12px;color:var(--muted);">Bugün ve sonrası (iptal hariç)</div>
                </div>

                <div>
                    <div class="d-flex justify-content-between mb-1" style="font-size:12.5px;">
                        <span style="font-weight:600;">Ortalama Memnuniyet</span>
                        <span style="font-weight:700;color:var(--blue);">%@Model.SatisfactionPercent.ToString("0.#")</span>
                    </div>
                    <div style="background:#f0ede8;border-radius:6px;height:7px;overflow:hidden;">
                        <div style="width:@Model.SatisfactionPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:linear-gradient(90deg,var(--blue),#2563eb);border-radius:6px;"></div>
                    </div>
                </div>

                <div>
                    <div class="d-flex justify-content-between mb-1" style="font-size:12.5px;">
                        <span style="font-weight:600;">İptal Oranı</span>
                        <span style="font-weight:700;color:var(--red);">%@Model.CancelRatePercent.ToString("0.#")</span>
                    </div>
                    <div style="background:#f0ede8;border-radius:6px;height:7px;overflow:hidden;">
                        <div style="width:@Model.CancelRatePercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%;height:100%;background:linear-gradient(90deg,var(--red),#dc2626);border-radius:6px;"></div>
                    </div>
                </div>

            </div>

            <hr style="border-color:var(--border);margin:18px 0;">

            <div style="background:linear-gradient(135deg,var(--accent-soft),rgba(230,160,60,0.05));border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px;">
                <div style="font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin-bottom:8px;">
                    <i class="bi bi-calendar-week" style="color:var(--accent);"></i> Bu Haftanın Rezervasyonları
                </div>
                <div style="font-family:'Playfair Display',serif;font-size:28px;font-weight:800;color:var(--text);line-height:1;">
                    @Model.ThisWeekReservations
                </div>
                <div style="font-size:12px;color:var(--muted);margin-top:4px;">
                    Bu ay: <strong>@Model.ThisMonthReservations</strong> rezervasyon
                </div>
            </div>

        </div>
    </div>
</div>
