@model DatabaseMastery.HotCoffeePostgreSQL.Dtos.AdminAnalyticsDtos.StatisticsOverviewDto

<!-- BIG 3 -->
<div class="big-grid">
    <div class="big-card bc-amber">
        <div class="bc-bg">👥</div>
        <div class="big-lbl">Ortalama Grup Büyüklüğü</div>
        <div class="big-num">@Model.AverageGroupSize.ToString("0.0")</div>
        <div class="big-sub">Rezervasyon başına kişi sayısı</div>
        <div class="big-trend tu">
            <i class="bi bi-people-fill"></i> Toplam misafir toplamından hesaplandı
        </div>
    </div>
    <div class="big-card bc-sky">
        <div class="bc-bg">⭐</div>
        <div class="big-lbl">Ortalama Müşteri Puanı</div>
        <div class="big-num" style="color:var(--accent-dark);">@Model.AverageRating.ToString("0.0")</div>
        <div class="big-sub">@Model.TotalReviews değerlendirme üzerinden</div>
        <div class="big-trend tu">
            <i class="bi bi-star-fill"></i> 5 üzerinden ortalama puan
        </div>
    </div>
    <div class="big-card bc-sage">
        <div class="bc-bg">📅</div>
        <div class="big-lbl">Günlük Ort. Rezervasyon</div>
        <div class="big-num" style="color:#16a34a;">@Model.DailyAverageReservationsLast30Days.ToString("0.0")</div>
        <div class="big-sub">Son 30 gün ortalaması</div>
        <div class="big-trend tu">
            <i class="bi bi-calendar-check"></i> Son 30 günde @Model.DailyAverageReservationsLast30Days.ToString("0.0")/gün
        </div>
    </div>
</div>
