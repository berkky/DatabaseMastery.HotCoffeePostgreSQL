@model IReadOnlyList<DatabaseMastery.HotCoffeePostgreSQL.Dtos.AdminAnalyticsDtos.RecentReservationDto>
@using DatabaseMastery.HotCoffeePostgreSQL.Domain

<!-- ══════════════════════════════════════════
     2. REZERVASYON TABLOSU  +  3. AKTİVİTE
══════════════════════════════════════════ -->
<div class="row g-3 mb-4">

    <!-- TABLO -->
    <div class="col-xl-8">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <div>
                    <div class="section-title">Bugünkü Rezervasyonlar</div>
                    <div class="section-sub">@(Model?.Count ?? 0) adet rezervasyon</div>
                </div>
                <a asp-controller="Reservation" asp-action="ReservationList" class="view-all">
                    Tümünü Gör <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="dash-table-wrap">
                <table class="res-table dash-res-table-compact">
                    <thead>
                        <tr>
                            <th>Misafir</th>
                            <th>Saat</th>
                            <th>Kişi</th>
                            <th>Durum</th>
                            <th class="text-center">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || Model.Count == 0)
                        {
                            <tr>
                                <td colspan="5" style="text-align:center;padding:48px 24px;">
                                    <div style="display:flex;flex-direction:column;align-items:center;gap:10px;">
                                        <div style="width:56px;height:56px;background:#f5f2ee;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;color:#ccc;border:2px dashed #e0d9ce;">
                                            <i class="bi bi-calendar2-x"></i>
                                        </div>
                                        <div style="font-family:'Playfair Display',serif;font-size:15px;font-weight:700;color:#333;">Bugün için rezervasyon bulunmuyor</div>
                                        <div style="font-size:12.5px;color:#bbb;">Yeni rezervasyon eklemek için butona tıklayın.</div>
                                        <a href="/Reservation/CreateReservation" class="btn-add" style="margin-top:4px;display:inline-flex;">
                                            <i class="bi bi-plus-lg"></i> Yeni Rezervasyon
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var r in Model)
                            {
                                var displayStatus = ReservationStatusPresentation.GetDisplayName(r.Status);
                                var statusClass = ReservationStatusPresentation.GetBadgeCssClass(r.Status);

                                <tr>
                                    <td>
                                        <span style="font-weight:700;">@r.Name</span>
                                    </td>
                                    <td>@r.ReservationTime.ToString("HH:mm")</td>
                                    <td>
                                        <span class="guest-chip">
                                            <i class="bi bi-people-fill" style="font-size:10px;"></i>
                                            @r.GuestCount
                                        </span>
                                    </td>
                                    <td>
                                        <span class="s-badge @statusClass">
                                            <span class="s-dot"></span>@displayStatus
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex justify-content-center gap-1 dash-row-actions">
                                            <a href="/Reservation/UpdateReservation/@r.ReservationId"
                                               class="btn-xs bx-edit" data-tip="Düzenle" aria-label="Düzenle">
                                                <i class="bi bi-pencil-fill"></i>
                                            </a>
                                            <form asp-controller="Reservation" asp-action="ApproveReservation" asp-route-id="@r.ReservationId" method="post" class="d-inline">
                                                <button type="submit" class="btn-xs bx-ok" data-tip="Onayla" aria-label="Onayla">
                                                    <i class="bi bi-check-lg"></i>
                                                </button>
                                            </form>
                                            <form asp-controller="Reservation" asp-action="CancelReservation" asp-route-id="@r.ReservationId" method="post" class="d-inline">
                                                <button type="submit" class="btn-xs bx-cancel" data-tip="İptal Et" aria-label="İptal Et">
                                                    <i class="bi bi-x-lg"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- AKTİVİTE PANELİ -->
    <div class="col-xl-4">
        <div class="dash-card h-100">
            <div class="dash-card-header">
                <div>
                    <div class="section-title">Günlük Aktiviteler</div>
                    <div class="section-sub">Bugünkü rezervasyon özeti</div>
                </div>
            </div>
            <div class="dash-card-body pt-0">
                <div class="timeline">

                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var r in Model.Take(7))
                        {
                            var (iconClass, iconColor, bgColor, title) = r.Status switch
                            {
                                ReservationStatus.Confirmed => ("bi-check-circle-fill", "var(--green)", "var(--green-soft)", "Rezervasyon onaylandı"),
                                ReservationStatus.Cancelled => ("bi-x-circle-fill", "var(--red)", "var(--red-soft)", "Rezervasyon iptal edildi"),
                                _ => ("bi-calendar2-check-fill", "var(--accent-dark)", "var(--accent-soft)", "Rezervasyon oluşturuldu")
                            };

                            <div class="tl-item">
                                <div class="tl-icon" style="background:@bgColor;">
                                    <i class="bi @iconClass" style="color:@iconColor;"></i>
                                </div>
                                <div class="tl-content">
                                    <div class="tl-title">@title</div>
                                    <div class="tl-desc">@r.Name — @r.GuestCount kişi, @r.ReservationTime.ToString("HH:mm")</div>
                                    <div class="tl-time">@TurkishDatePresentation.FormatDateShort(r.ReservationDate)</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div style="text-align:center;padding:32px 0;color:var(--muted);font-size:13px;">
                            <i class="bi bi-clock-history" style="font-size:28px;display:block;margin-bottom:10px;color:#ddd;"></i>
                            Bugün henüz rezervasyon yok.
                        </div>
                    }

                </div>
            </div>
        </div>
    </div>

</div>
