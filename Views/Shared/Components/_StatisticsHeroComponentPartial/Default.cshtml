@model DatabaseMastery.HotCoffeePostgreSQL.Dtos.AdminAnalyticsDtos.StatisticsOverviewDto

<!-- HEADER -->
<div class="pg-header">
    <div>
        <h1 class="pg-title"><i class="bi bi-bar-chart-line-fill me-2" style="color:var(--accent);font-size:20px;vertical-align:middle;"></i>İstatistikler</h1>
        <p class="pg-sub">Restoranın genel performans ve analiz özeti.</p>
    </div>
    <div class="date-badge"><i class="bi bi-calendar3"></i><span id="liveDate"></span></div>
</div>

<!-- HERO -->
<div class="hero-banner">
    <div class="hero-stat"><div class="hero-stat-num ac">@Model.TotalReservations</div><div class="hero-stat-lbl">Toplam Rezervasyon</div><div class="hero-stat-sub">Tüm zamanlar</div></div>

    <div class="hero-stat"><div class="hero-stat-num">@Model.TotalGuestCount</div><div class="hero-stat-lbl">Toplam Misafir</div><div class="hero-stat-sub">Bu hafta onaylı: @Model.ThisWeekConfirmedGuestCount</div></div>

    <div class="hero-stat"><div class="hero-stat-num ac">@Model.AverageRating.ToString("0.0")</div><div class="hero-stat-lbl">Ortalama Puan</div><div class="hero-stat-sub">@Model.TotalReviews değerlendirme</div></div>

    <div class="hero-stat"><div class="hero-stat-num">@Model.ActiveProducts</div><div class="hero-stat-lbl">Aktif Ürün</div><div class="hero-stat-sub">@Model.ActiveCategories aktif kategoride</div></div>
</div>
