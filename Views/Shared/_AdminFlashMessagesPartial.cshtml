@using DatabaseMastery.HotCoffeePostgreSQL.Services
@if (TempData[AdminFlashMessages.WarningKey] is string warningMessage)
{
    <div class="admin-flash admin-flash-warning" role="alert">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@warningMessage</span>
    </div>
}
@if (TempData[AdminFlashMessages.SuccessKey] is string successMessage)
{
    <div class="admin-flash admin-flash-success" role="alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@successMessage</span>
    </div>
}

<style>
    .admin-flash {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 16px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-size: 13.5px;
        line-height: 1.45;
    }

    .admin-flash-warning {
        background: rgba(239, 68, 68, 0.10);
        border: 1px solid rgba(239, 68, 68, 0.25);
        color: #b91c1c;
    }

    .admin-flash-success {
        background: rgba(34, 197, 94, 0.10);
        border: 1px solid rgba(34, 197, 94, 0.25);
        color: #15803d;
    }
</style>
